#!/usr/bin/env python3
"""Drop stale finished sessions out of Claude Code's agent view.

Usage: claude-prune-agents [--hours N] [--states done,stopped] [--dry-run]
       Run by hand; no timer runs it.
       Default cutoff: finished and idle for more than 72 hours.

Claude prunes ~/.claude/projects, plans, tasks and friends at startup via
cleanupPeriodDays, but ~/.claude/jobs is not in that sweep, so the agent-view
list grows forever. This calls `claude rm <id>`, which drops the row and the
job dir while KEEPING the transcript — `claude --resume` / `/resume` still
reach the conversation.

Only finished sessions age out. Anything pinned (~/.claude/jobs/pins.json),
still running, or waiting on input is left alone, as is any state not listed in
--states. `claude rm` refuses to discard a worktree with uncommitted changes or
unpushed commits, so it is the only safe way to do this — never rm -rf a job dir.
"""

import argparse
import calendar
import json
import os
import subprocess
import sys
import time

JOBS = os.path.expanduser("~/.claude/jobs")


def finished_sessions():
    out = subprocess.run(
        ["claude", "agents", "--json", "--all"],
        capture_output=True,
        text=True,
        timeout=60,
    )
    if out.returncode != 0:
        sys.exit(f"claude agents --json --all failed: {out.stderr.strip()}")
    try:
        sessions = json.loads(out.stdout)
    except ValueError:
        # A `claude` wrapper earlier on PATH can print its own chatter to stdout
        # ahead of the JSON, so fail with the text instead of a bare traceback.
        sys.exit(f"claude agents --json --all returned non-JSON: {out.stdout[:200]!r}")
    return [s for s in sessions if s.get("kind") == "background"]


def pinned_ids():
    # pins.json's shape is Claude's to change, so harvest every string in it
    # rather than assuming a key: a missed pin would delete a session the user
    # deliberately kept.
    try:
        with open(os.path.join(JOBS, "pins.json")) as fh:
            pins = json.load(fh)
    except (OSError, ValueError):
        return set()
    found = set()
    stack = [pins]
    while stack:
        node = stack.pop()
        if isinstance(node, str):
            found.add(node)
        elif isinstance(node, dict):
            stack.extend(node.values())
        elif isinstance(node, list):
            stack.extend(node)
    return found


def idle_hours(job_id):
    path = os.path.join(JOBS, job_id, "state.json")
    try:
        with open(path) as fh:
            stamp = json.load(fh).get("updatedAt")
        seconds = time.time() - calendar.timegm(
            time.strptime(stamp, "%Y-%m-%dT%H:%M:%S.%fZ")
        )
    except (OSError, ValueError, TypeError):
        try:
            seconds = time.time() - os.path.getmtime(os.path.join(JOBS, job_id))
        except OSError:
            return None
    return seconds / 3600


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--hours", type=float, default=72)
    ap.add_argument("--states", default="done,stopped")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    keep_states = {s.strip() for s in args.states.split(",") if s.strip()}
    pinned = pinned_ids()
    removed = kept = 0

    for session in finished_sessions():
        job_id, state = session.get("id"), session.get("state")
        if not job_id or state not in keep_states:
            continue
        if job_id in pinned or session.get("pinned"):
            continue
        age = idle_hours(job_id)
        if age is None or age < args.hours:
            kept += 1
            continue
        name = session.get("name") or "(unnamed)"
        if args.dry_run:
            print(f"would remove {job_id} [{state}, {age:.0f}h] {name}")
            removed += 1
            continue
        rm = subprocess.run(
            ["claude", "rm", job_id], capture_output=True, text=True, timeout=120
        )
        if rm.returncode == 0:
            print(f"removed {job_id} [{state}, {age:.0f}h] {name}")
            removed += 1
        else:
            print(f"kept {job_id}: {(rm.stderr or rm.stdout).strip()}")
            kept += 1

    print(f"{'would remove' if args.dry_run else 'removed'} {removed}, kept {kept}")


if __name__ == "__main__":
    main()
