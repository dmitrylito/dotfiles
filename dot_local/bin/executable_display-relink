#!/bin/bash
# Wakes the displays after idle and re-trains any HDMI link amdgpu failed to bring up.
#
# Usage: display-relink   (run by the dmitrylito.display-idle shell plugin on activity)
# Waking from DPMS off, amdgpu sometimes logs "enabling link N failed: 19" for the
# HDMI monitor: Hyprland still reports the output on, but the panel stays black.
# Cycling that output's DPMS re-trains the link.
# Env: DISPLAY_RELINK_SETTLE seconds to wait before checking the kernel log (default 3),
#      DISPLAY_RELINK_RETRIES DPMS cycles before giving up (default 3).
# Needs: journalctl -k readable without sudo, jq, a Hyprland session.

set -uo pipefail

settle="${DISPLAY_RELINK_SETTLE:-3}"
retries="${DISPLAY_RELINK_RETRIES:-3}"

dpms() {
  hyprctl dispatch "hl.dsp.dpms({ action = \"$1\", monitor = \"$2\" })" >/dev/null 2>&1
}

link_failed_since() {
  journalctl -k -q --no-pager --since "@$1" 2>/dev/null | grep -qE 'enabling link [0-9]+ failed'
}

since=$(date +%s)
omarchy-system-wake
omarchy-hw-laptop-closed && dpms disable eDP-1

mapfile -t hdmi < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name | select(startswith("HDMI-"))')
((${#hdmi[@]})) || exit 0

for ((attempt = 1; attempt <= retries; attempt++)); do
  sleep "$settle"
  link_failed_since "$since" || exit 0
  since=$(date +%s)
  for output in "${hdmi[@]}"; do dpms disable "$output"; done
  sleep 2
  for output in "${hdmi[@]}"; do dpms enable "$output"; done
done

sleep "$settle"
link_failed_since "$since" || exit 0
echo "display-relink: HDMI link still failing after $retries DPMS cycles" >&2
exit 1
