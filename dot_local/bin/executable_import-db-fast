#!/bin/bash
#
# import-db-fast — daytime refresh of the local FleetChaser DB.
#
# Runs ~/.local/bin/import-db unchanged, except the poi_locationhistory exclusion
# constraint `dont_overlap` (the slowest post-data step) is left out of the restore.
# The nightly cron keeps running plain import-db, so the full DB comes back overnight.
#
# Usage: import-db-fast [--fg]   # same flags as import-db
#
# RESTORE_SKIP_OBJECTS is import-db's own knob; names are dump-header names with
# non-alphanumerics replaced by _ (poi_locationhistory dont_overlap → below).
export RESTORE_SKIP_OBJECTS="${RESTORE_SKIP_OBJECTS:-poi_locationhistory_dont_overlap}"
exec "$HOME/.local/bin/import-db" "$@"
