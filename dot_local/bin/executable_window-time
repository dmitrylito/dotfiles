#!/usr/bin/python3
#
# window-time — how long each Hyprland window has focus, with the page URL for
# Chromium / Chrome windows, looked up by page title in the browser's History DB.
#
#   window-time watch                 run the tracker (systemd: window-time.service)
#   window-time report [SINCE] [--by window|app|site]
#                                     totals, longest first
#   window-time log [SINCE]           focus timeline, one line per stretch
#   window-time export [SINCE] [--until UNTIL]
#                                     spans and calls as JSON, for fc-daily-report
#
# report and log skip stretches shorter than --min seconds (default
# MIN_SPAN_SECONDS): focus passing through windows on the way to another.
#   window-time idle SECONDS          tell the tracker input stopped SECONDS ago
#   window-time active                tell the tracker input is back
#
# SINCE: today (default), yesterday, week, 30m / 2h / 3d, YYYY-MM-DD[ HH:MM], or @EPOCH.
#
# Data lives in $XDG_DATA_HOME/window-time/window-time.db: `spans` (focus),
# `calls` (a CALL_APPS process recording the mic, tracked whatever has focus) and
# `panes` (the focused herdr pane and its Claude/Codex session id, polled every
# HERDR_POLL_SECONDS while a herdr terminal has focus; remote hosts over SSH) and
# `idle` (time away, with the window that was holding the screen awake, if any,
# e.g. a video or Meet tab).
# Browser URLs come from the window-time Chromium extension when it is loaded
# (`url_source` = tab: the active tab's exact URL, a new span per navigation);
# otherwise from History, matched by title (`url_source` = history).
#   window-time tab                   Chromium native-messaging host (the extension)
# Idle reports come from the dmitrylito.window-time omarchy shell plugin; without
# it, time away from the keyboard counts toward whichever window had focus.
# Idle is ignored while a CALL_APPS process records the microphone (a Meet or
# Dialpad call), so call time still counts, toward whichever window has focus.
#
# URL lookup is a best guess: Chromium writes History a few seconds late, and only
# keeps the latest title per URL, so a title shared by several pages (or one that
# changed since) maps to the last matching visit before the span ended, or to nothing.
# /usr/bin/python3 on purpose: stdlib only, and the mise shim is not wanted here.

import argparse
import json
import os
import re
import select
import signal
import socket
import sqlite3
import subprocess
import sys
import threading
import time
from datetime import datetime, timedelta
from pathlib import Path
from urllib.parse import quote, urlsplit

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "window-time"
DB_PATH = DATA_DIR / "window-time.db"
CONTROL_SOCKET = RUNTIME_DIR / "window-time.sock"

CHECKPOINT_SECONDS = 15
# A tab report arriving this soon after a span opened belongs to that span (the
# window title and the extension race); later, a different URL starts a new span.
TAB_SETTLE_SECONDS = 2
TAB_MEMORY = 500
MIN_SPAN_SECONDS = 1.0

# application.process.binary of PipeWire capture streams that mean "on a call".
# NoiseTorch and voxtype also record the mic, so this is an allowlist.
CALL_APPS = {"chromium", "chrome", "zoom", "slack", "discord", "teams-for-linux"}

# Browser window class -> user data dir. Web app windows ("chrome-<host>__<path>-
# <Profile_N>") carry no browser name, so every data dir is searched for those.
BROWSER_DATA_DIRS = {
    "chromium": Path.home() / ".config/chromium",
    "google-chrome": Path.home() / ".config/google-chrome",
}
CHROMIUM_EPOCH_OFFSET = 11_644_473_600

HERDR_POLL_SECONDS = 2
HERDR_SNAPSHOT_TIMEOUT = 5
# Terminal windows attached to herdr are titled "<host>: <workspace>". The title's
# host (lowercased) -> SSH target for hosts other than this one.
HERDR_REMOTES = {"dlco-1": "dlco-1.chimera-pleco.ts.net"}
HERDR_TERMINAL_CLASSES = {"com.mitchellh.ghostty", "org.omarchy.terminal"}
# The SUPER+S scratchpad (herdr-agent) runs its own herdr session.
HERDR_SESSION_BY_CLASS = {"org.omarchy.agent": "scratchpad"}
HERDR_TITLE_HOST = re.compile(r"^(?P<host>[\w.-]+): ")
BROWSER_TITLE_SUFFIX = re.compile(r" - (Chromium|Google Chrome)$")
WEBAPP_CLASS = re.compile(r"^chrome-(?P<host>.+?)__(?P<path>.*)-(?P<profile>Default|Profile_\d+)$")

# Terminals running agents animate a spinner in the title; without stripping it
# every frame would start a new span.
TITLE_SPINNER = re.compile("^[\u2800-\u28ff\u25a0-\u25ff\u2722-\u273d\u00b7*\\s]+")

SCHEMA = """
create table if not exists spans (
    id integer primary key,
    start real not null,
    end real not null,
    class text not null,
    title text not null,
    profile text,
    url text
);
create index if not exists spans_start on spans (start);
create table if not exists calls (
    id integer primary key,
    start real not null,
    end real not null,
    apps text not null
);
create index if not exists calls_start on calls (start);
create table if not exists panes (
    id integer primary key,
    start real not null,
    end real not null,
    host text not null,
    session text,
    workspace text,
    pane text not null,
    agent text,
    agent_session text,
    cwd text,
    title text
);
create index if not exists panes_start on panes (start);
create table if not exists idle (
    id integer primary key,
    start real not null,
    end real not null,
    inhibitor_class text,
    inhibitor_title text
);
create index if not exists idle_start on idle (start);
"""


def connect_db():
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(DB_PATH, timeout=10)
    db.execute("pragma journal_mode=wal")
    db.executescript(SCHEMA)
    if "url_source" not in {row[1] for row in db.execute("pragma table_info(spans)")}:
        db.execute("alter table spans add column url_source text")
    return db


def is_browser(cls):
    return cls in BROWSER_DATA_DIRS or bool(WEBAPP_CLASS.match(cls))


def profile_names(data_dir):
    try:
        cache = json.loads((data_dir / "Local State").read_text())["profile"]["info_cache"]
    except (OSError, ValueError, KeyError):
        return {}
    return {directory: info.get("name") or directory for directory, info in cache.items()}


def chromium_time(epoch):
    return int((epoch + CHROMIUM_EPOCH_OFFSET) * 1_000_000)


def latest_visit(history, title, before):
    # immutable=1: Chromium holds an exclusive lock on History while it runs.
    # Single-page apps give many pages one title ("Fleet Chaser"), so the visit
    # nearest before the span's end beats the title's most recent visit overall.
    uri = f"file:{quote(str(history))}?immutable=1"
    try:
        with sqlite3.connect(uri, uri=True) as db:
            return db.execute(
                "select u.url, v.visit_time from visits v join urls u on u.id = v.url "
                "where u.title = ? and v.visit_time <= ? order by v.visit_time desc limit 1",
                (title, chromium_time(before)),
            ).fetchone()
    except sqlite3.Error:
        return None


def resolve_url(cls, title, before):
    """Return (profile name, url) for a browser window, or (None, None)."""
    if webapp := WEBAPP_CLASS.match(cls):
        wanted = webapp["profile"].replace("_", " ")
        data_dirs = list(BROWSER_DATA_DIRS.values())
    else:
        wanted = None
        data_dirs = [BROWSER_DATA_DIRS[cls]]
        title = BROWSER_TITLE_SUFFIX.sub("", title)
    best = (None, None, -1)
    for data_dir in data_dirs:
        names = profile_names(data_dir)
        for directory in [wanted] if wanted else names:
            history = data_dir / directory / "History"
            if not history.exists():
                continue
            if (hit := latest_visit(history, title, before)) and hit[1] > best[2]:
                best = (names.get(directory, directory), hit[0], hit[1])
    if best[1] is None and webapp:
        names = {}
        for data_dir in data_dirs:
            names |= profile_names(data_dir)
        return names.get(wanted, wanted), None
    return best[0], best[1]


def page_title(title):
    return BROWSER_TITLE_SUFFIX.sub("", title)


def profile_for_url(cls, url):
    if webapp := WEBAPP_CLASS.match(cls):
        wanted = webapp["profile"].replace("_", " ")
        names = {}
        for data_dir in BROWSER_DATA_DIRS.values():
            names |= profile_names(data_dir)
        return names.get(wanted, wanted)
    best, best_time = None, -1
    data_dir = BROWSER_DATA_DIRS.get(cls)
    for directory, name in (profile_names(data_dir) if data_dir else {}).items():
        uri = f"file:{quote(str(data_dir / directory / 'History'))}?immutable=1"
        try:
            with sqlite3.connect(uri, uri=True) as history:
                row = history.execute("select last_visit_time from urls where url = ?", (url,)).fetchone()
        except sqlite3.Error:
            continue
        if row and row[0] > best_time:
            best, best_time = name, row[0]
    return best


def hyprctl_json(signature, *args):
    env = os.environ | {"HYPRLAND_INSTANCE_SIGNATURE": signature or ""}
    try:
        result = subprocess.run(["hyprctl", "-j", *args], env=env, capture_output=True, text=True, timeout=3)
        return json.loads(result.stdout or "null")
    except (subprocess.TimeoutExpired, ValueError, OSError):
        return None


def inhibiting_window(signature):
    for client in hyprctl_json(signature, "clients") or []:
        if client.get("inhibitingIdle") and client.get("mapped") and not client.get("hidden"):
            return client.get("class"), client.get("title")
    return None, None


def hypr_signatures():
    hypr = RUNTIME_DIR / "hypr"
    preferred = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    others = sorted(
        (p.name for p in hypr.glob("*") if (p / ".socket2.sock").exists()),
        key=lambda name: (hypr / name).stat().st_mtime,
        reverse=True,
    ) if hypr.is_dir() else []
    return ([preferred] if preferred else []) + [s for s in others if s != preferred]


def connect_hyprland():
    # Dead sessions leave socket files behind, some still accepting connections, so
    # a signature only counts once hyprctl answers through it.
    for signature in hypr_signatures():
        env = os.environ | {"HYPRLAND_INSTANCE_SIGNATURE": signature}
        try:
            active = subprocess.run(
                ["hyprctl", "-j", "activewindow"], env=env, capture_output=True, text=True, timeout=3
            )
            window = json.loads(active.stdout or "{}") if active.returncode == 0 else None
        except (subprocess.TimeoutExpired, ValueError, OSError):
            window = None
        if window is None:
            continue
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.connect(str(RUNTIME_DIR / "hypr" / signature / ".socket2.sock"))
        except OSError:
            sock.close()
            continue
        return sock, window, signature
    return None, None, None


def herdr_target(cls, title):
    """Return (host, ssh target or None, herdr session or None) for a herdr window."""
    local = socket.gethostname().lower()
    if cls in HERDR_SESSION_BY_CLASS:
        return local, None, HERDR_SESSION_BY_CLASS[cls]
    if cls not in HERDR_TERMINAL_CLASSES or not (match := HERDR_TITLE_HOST.match(title)):
        return None
    host = match["host"].lower()
    if host == local:
        return local, None, None
    if host in HERDR_REMOTES:
        return host, HERDR_REMOTES[host], None
    return None


def herdr_focus(target):
    host, ssh_target, session = target
    command = ["herdr"] + (["--session", session] if session else []) + ["api", "snapshot"]
    if ssh_target:
        command = [
            "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
            "-o", "ControlMaster=auto", "-o", "ControlPersist=300",
            "-o", f"ControlPath={RUNTIME_DIR}/window-time-ssh-%C",
            ssh_target, " ".join(command),
        ]
    try:
        # HERDR_* (set inside a herdr pane) would point herdr at that pane's server.
        env = {key: value for key, value in os.environ.items() if not key.startswith("HERDR_")}
        result = subprocess.run(command, capture_output=True, text=True, timeout=HERDR_SNAPSHOT_TIMEOUT, env=env)
        snapshot = json.loads(result.stdout)["result"]["snapshot"]
    except (subprocess.TimeoutExpired, ValueError, KeyError, OSError):
        return None
    pane = next((p for p in snapshot.get("panes", []) if p.get("pane_id") == snapshot.get("focused_pane_id")), None)
    if pane is None:
        return None
    workspace = next(
        (w.get("label") for w in snapshot.get("workspaces", []) if w.get("workspace_id") == pane.get("workspace_id")),
        None,
    )
    return {
        "host": host,
        "session": session or "default",
        "workspace": workspace,
        "pane": pane["pane_id"],
        "agent": pane.get("agent"),
        "agent_session": (pane.get("agent_session") or {}).get("value"),
        "cwd": pane.get("foreground_cwd") or pane.get("cwd"),
        "title": pane.get("terminal_title_stripped") or pane.get("terminal_title"),
    }


class HerdrWatcher(threading.Thread):
    """Records which herdr pane has focus inside the focused terminal window."""

    KEY = ("host", "session", "pane", "agent", "agent_session")

    def __init__(self):
        super().__init__(daemon=True)
        self.target = self.title = None
        self.wake = threading.Event()

    def follow(self, target, title=None):
        # A new window title often means another herdr workspace: poll at once.
        if (target, title) != (self.target, self.title):
            self.target, self.title = target, title
            self.wake.set()

    def run(self):
        db = connect_db()
        row_id = key = None
        while True:
            self.wake.clear()
            now = time.time()
            focus = herdr_focus(self.target) if self.target else None
            new_key = tuple(focus[k] for k in self.KEY) if focus else None
            if row_id is not None and new_key != key:
                db.execute("update panes set end = ? where id = ?", (now, row_id))
                row_id = None
            if focus and row_id is None:
                row_id = db.execute(
                    "insert into panes (start, end, host, session, workspace, pane, agent, agent_session, cwd, title)"
                    " values (:start, :start, :host, :session, :workspace, :pane, :agent, :agent_session, :cwd, :title)",
                    focus | {"start": now},
                ).lastrowid
            elif focus:
                db.execute(
                    "update panes set end = ?, cwd = ?, title = ? where id = ?",
                    (now, focus["cwd"], focus["title"], row_id),
                )
            db.commit()
            key = new_key
            self.wake.wait(HERDR_POLL_SECONDS)


def clean_title(title):
    return TITLE_SPINNER.sub("", title).strip()


def call_apps():
    try:
        result = subprocess.run(
            ["pactl", "-f", "json", "list", "source-outputs"], capture_output=True, text=True, timeout=3
        )
        streams = json.loads(result.stdout or "[]")
    except (subprocess.TimeoutExpired, ValueError, OSError):
        return set()
    binaries = {stream["properties"].get("application.process.binary") for stream in streams}
    return binaries & CALL_APPS


class Tracker:
    def __init__(self, db):
        self.db = db
        self.span_id = None
        self.span_start = None
        self.cls = ""
        self.title = ""
        self.address = ""
        self.input_idle = False
        self.in_call = False
        self.call_id = None
        self.idle_id = None
        self.idle_inhibitor = None
        self.signature = None
        self.span_url = self.span_url_source = None
        self.tabs = {}

    @property
    def away(self):
        return self.input_idle and not self.in_call

    def focus(self, cls, title, now):
        title = clean_title(title)
        if (cls, title) == (self.cls, self.title):
            return
        self.close(now)
        self.cls, self.title = cls, title
        self.open(now)

    def open(self, now):
        if self.away or not self.cls:
            return
        cur = self.db.execute(
            "insert into spans (start, end, class, title) values (?, ?, ?, ?)",
            (now, now, self.cls, self.title),
        )
        self.db.commit()
        self.span_id, self.span_start = cur.lastrowid, now
        self.span_url = self.span_url_source = None
        if is_browser(self.cls) and (url := self.tabs.get(page_title(self.title))):
            self.set_tab_url(url)

    def set_tab_url(self, url):
        self.span_url, self.span_url_source = url, "tab"
        self.db.execute(
            "update spans set url = ?, url_source = 'tab', profile = ? where id = ?",
            (url, profile_for_url(self.cls, url), self.span_id),
        )
        self.db.commit()

    def tab(self, report, now):
        title, url = report.get("title") or "", report.get("url")
        if not url:
            return
        self.tabs.pop(title, None)
        self.tabs[title] = url
        while len(self.tabs) > TAB_MEMORY:
            self.tabs.pop(next(iter(self.tabs)))
        if self.span_id is None or not is_browser(self.cls) or page_title(self.title) != title:
            return
        if url == self.span_url:
            return
        if self.span_url_source == "tab" and now - self.span_start > TAB_SETTLE_SECONDS:
            self.close(now)
            self.open(now)
        if self.span_id is not None and self.span_url != url:
            self.set_tab_url(url)

    def close(self, end):
        if self.span_id is None:
            return
        self.db.execute("update spans set end = ? where id = ?", (max(end, self.span_start), self.span_id))
        self.db.commit()
        self.resolve(end)
        self.span_id = None

    def resolve(self, before):
        if self.span_id is None or not is_browser(self.cls):
            return
        if self.span_url_source == "tab":
            # History is written a few seconds late, so the profile may only now be findable.
            profile = profile_for_url(self.cls, self.span_url)
            self.db.execute("update spans set profile = ? where id = ?", (profile, self.span_id))
        else:
            profile, url = resolve_url(self.cls, self.title, before)
            self.db.execute(
                "update spans set profile = ?, url = ?, url_source = ? where id = ?",
                (profile, url, "history" if url else None, self.span_id),
            )
        self.db.commit()

    def update_call(self, now):
        apps = call_apps()
        if apps and self.call_id is None:
            cur = self.db.execute(
                "insert into calls (start, end, apps) values (?, ?, ?)", (now, now, ",".join(sorted(apps)))
            )
            self.call_id = cur.lastrowid
        elif self.call_id is not None:
            self.db.execute("update calls set end = ? where id = ?", (now, self.call_id))
            if not apps:
                self.call_id = None
        self.db.commit()
        self.set_call(bool(apps), now)

    def end_call(self, now):
        if self.call_id is not None:
            self.db.execute("update calls set end = ? where id = ?", (now, self.call_id))
            self.db.commit()
            self.call_id = None

    def checkpoint(self, now):
        self.update_call(now)
        if self.span_id is not None:
            self.db.execute("update spans set end = ? where id = ?", (now, self.span_id))
            self.db.commit()
            self.resolve(now)
        if self.idle_id is not None:
            self.db.execute("update idle set end = ? where id = ?", (now, self.idle_id))
            self.note_inhibitor()

    def note_inhibitor(self):
        if self.idle_inhibitor is None:
            cls, title = inhibiting_window(self.signature)
            if cls:
                self.idle_inhibitor = (cls, title)
                self.db.execute(
                    "update idle set inhibitor_class = ?, inhibitor_title = ? where id = ?",
                    (cls, clean_title(title or ""), self.idle_id),
                )
        self.db.commit()

    def sync_idle(self, now, start=None):
        if self.away and self.idle_id is None:
            start = now if start is None else start
            self.idle_id = self.db.execute("insert into idle (start, end) values (?, ?)", (start, now)).lastrowid
            self.idle_inhibitor = None
            self.note_inhibitor()
        elif not self.away and self.idle_id is not None:
            self.db.execute("update idle set end = ? where id = ?", (now, self.idle_id))
            self.db.commit()
            self.idle_id = None

    def set_call(self, in_call, now):
        was_away = self.away
        self.in_call = in_call
        if was_away and not self.away:
            self.open(now)
        elif self.away and not was_away:
            self.close(now)
        self.sync_idle(now)

    def go_idle(self, seconds, now):
        self.update_call(now)
        self.input_idle = True
        if self.away:
            self.close(now - seconds)
        self.sync_idle(now, now - seconds)

    def go_active(self, now):
        was_away = self.away
        self.input_idle = False
        self.sync_idle(now)
        if was_away:
            self.open(now)

    def handle_event(self, line, now):
        name, _, data = line.partition(">>")
        if name == "activewindow":
            cls, _, title = data.partition(",")
            self.focus(cls, title, now)
        elif name == "activewindowv2":
            self.address = data.removeprefix("0x")
        elif name == "windowtitlev2":
            address, _, title = data.partition(",")
            if address.removeprefix("0x") == self.address:
                self.focus(self.cls, title, now)


def audio_events():
    # Mic streams opening and closing show up here at once; the checkpoint poll
    # covers the time while pactl is down (pipewire-pulse restarting).
    try:
        return subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
    except OSError:
        return None


def watch(_args):
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    db = connect_db()
    tracker = Tracker(db)
    CONTROL_SOCKET.unlink(missing_ok=True)
    control = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    control.bind(str(CONTROL_SOCKET))
    audio = audio_events()
    herdr = HerdrWatcher()
    herdr.start()
    try:
        while True:
            hypr, window, tracker.signature = connect_hyprland()
            if hypr is None:
                time.sleep(2)
                continue
            now = time.time()
            tracker.address = (window.get("address") or "").removeprefix("0x")
            tracker.focus(window.get("class", ""), window.get("title", ""), now)
            tracker.update_call(now)
            buffer = b""
            next_checkpoint = now + CHECKPOINT_SECONDS
            while True:
                sources = [hypr, control] + ([audio.stdout] if audio else [])
                ready, _, _ = select.select(sources, [], [], max(0, next_checkpoint - time.time()))
                now = time.time()
                if audio and audio.stdout in ready:
                    events = os.read(audio.stdout.fileno(), 65536)
                    if not events:
                        audio.wait()
                        audio = None
                    elif b"source-output" in events:
                        tracker.update_call(now)
                if control in ready:
                    raw = control.recv(65536).decode(errors="replace")
                    message = raw.split()
                    if raw.startswith("tab "):
                        try:
                            tracker.tab(json.loads(raw[4:]), now)
                        except ValueError:
                            pass
                    elif message[:1] == ["idle"] and len(message) == 2:
                        tracker.go_idle(float(message[1]), now)
                    elif message[:1] == ["active"]:
                        tracker.go_active(now)
                if hypr in ready:
                    chunk = hypr.recv(65536)
                    if not chunk:
                        break
                    buffer += chunk
                    *lines, buffer = buffer.split(b"\n")
                    for line in lines:
                        tracker.handle_event(line.decode(errors="replace"), now)
                if now >= next_checkpoint:
                    tracker.checkpoint(now)
                    next_checkpoint = now + CHECKPOINT_SECONDS
                    audio = audio or audio_events()
                herdr.follow(None if tracker.away else herdr_target(tracker.cls, tracker.title), tracker.title)
            hypr.close()
            herdr.follow(None)
            tracker.close(time.time())
            tracker.cls = tracker.title = ""
            time.sleep(1)
    finally:
        tracker.close(time.time())
        tracker.end_call(time.time())
        tracker.input_idle = False
        tracker.sync_idle(time.time())
        if audio:
            audio.terminate()
        CONTROL_SOCKET.unlink(missing_ok=True)


def send_control(message):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.sendto(message.encode(), str(CONTROL_SOCKET))
    except OSError as error:
        print(f"window-time: tracker not reachable ({error})", file=sys.stderr)
        return 1
    return 0


def parse_since(text):
    midnight = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    if text == "today":
        return midnight
    if text.startswith("@"):
        return datetime.fromtimestamp(float(text[1:]))
    if text == "yesterday":
        return midnight - timedelta(days=1)
    if text == "week":
        return midnight - timedelta(days=midnight.weekday())
    if match := re.fullmatch(r"(\d+)([mhd])", text):
        unit = {"m": "minutes", "h": "hours", "d": "days"}[match[2]]
        return datetime.now() - timedelta(**{unit: int(match[1])})
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return datetime.strptime(text, fmt)
        except ValueError:
            pass
    raise SystemExit(f"window-time: cannot read SINCE {text!r}")


def load_spans(db, since, min_seconds):
    rows = db.execute(
        "select id, start, end, class, title, profile, url from spans where end > ? order by start",
        (since,),
    ).fetchall()
    spans = []
    for id_, start, end, cls, title, profile, url in rows:
        if end - start < min_seconds:
            continue
        if url is None and is_browser(cls):
            profile, url = resolve_url(cls, title, end)
            if url is not None:
                db.execute(
                    "update spans set profile = ?, url = ?, url_source = 'history' where id = ?", (profile, url, id_)
                )
        spans.append((max(start, since), end, cls, clean_title(title), profile, url))
    db.commit()
    return spans


def app_label(cls, profile):
    if webapp := WEBAPP_CLASS.match(cls):
        cls = f"{webapp['host']} app"
    return f"{cls} ({profile})" if profile else cls


def format_duration(seconds):
    seconds = int(seconds)
    hours, rest = divmod(seconds, 3600)
    minutes, seconds = divmod(rest, 60)
    if hours:
        return f"{hours}h {minutes:02d}m"
    if minutes:
        return f"{minutes}m {seconds:02d}s"
    return f"{seconds}s"


def report(args):
    since = parse_since(args.since)
    spans = load_spans(connect_db(), since.timestamp(), args.min)
    totals = {}
    for start, end, cls, title, profile, url in spans:
        app = app_label(cls, profile)
        title = BROWSER_TITLE_SUFFIX.sub("", title)
        if args.by == "app":
            key, url = app, None
        elif args.by == "site":
            key = urlsplit(url).hostname or url if url else app
            title, url = "", None
        else:
            key = (app, url or title)
        entry = totals.setdefault(key, {"seconds": 0.0, "app": app if args.by != "site" else key})
        entry["seconds"] += end - start
        entry["title"], entry["url"] = ("" if args.by == "app" else title), url
    grand = sum(entry["seconds"] for entry in totals.values())
    print(f"{format_duration(grand)} tracked since {since:%Y-%m-%d %H:%M}\n")
    width = max((len(entry["app"]) for entry in totals.values()), default=0)
    for entry in sorted(totals.values(), key=lambda entry: -entry["seconds"]):
        print(f"{format_duration(entry['seconds']):>8}  {entry['app']:<{width}}  {entry['title']}".rstrip())
        if entry["url"]:
            print(f"{'':>8}  {'':<{width}}  {entry['url']}")


def log(args):
    since = parse_since(args.since)
    for start, end, cls, title, profile, url in load_spans(connect_db(), since.timestamp(), args.min):
        print(
            f"{datetime.fromtimestamp(start):%H:%M:%S}  {format_duration(end - start):>8}  "
            f"{app_label(cls, profile)}  {BROWSER_TITLE_SUFFIX.sub('', title)}" + (f"  {url}" if url else "")
        )


def export(args):
    since = parse_since(args.since).timestamp()
    until = parse_since(args.until).timestamp() if args.until else time.time()
    db = connect_db()
    load_spans(db, since, args.min)
    spans = [
        {
            "start": max(start, since),
            "end": min(end, until),
            "class": cls,
            "title": clean_title(title),
            "profile": profile,
            "url": url,
            "url_source": url_source,
        }
        for start, end, cls, title, profile, url, url_source in db.execute(
            "select start, end, class, title, profile, url, url_source from spans"
            " where end > ? and start < ? and end - start >= ? order by start",
            (since, until, args.min),
        )
    ]
    idle = [
        {
            "start": max(start, since),
            "end": min(end, until),
            "inhibitor_class": inhibitor_class,
            "inhibitor_title": inhibitor_title,
        }
        for start, end, inhibitor_class, inhibitor_title in db.execute(
            "select start, end, inhibitor_class, inhibitor_title from idle where end > ? and start < ? order by start",
            (since, until),
        )
    ]
    calls = [
        {"start": max(start, since), "end": min(end, until), "apps": apps.split(",")}
        for start, end, apps in db.execute(
            "select start, end, apps from calls where end > ? and start < ? order by start", (since, until)
        )
    ]
    db.row_factory = sqlite3.Row
    panes = [
        dict(row) | {"start": max(row["start"], since), "end": min(row["end"], until)}
        for row in db.execute(
            "select start, end, host, session, workspace, pane, agent, agent_session, cwd, title from panes"
            " where end > ? and start < ? order by start",
            (since, until),
        )
    ]
    json.dump(
        {
            "host": socket.gethostname(),
            "since": since,
            "until": until,
            "spans": spans,
            "calls": calls,
            "panes": panes,
            "idle": idle,
        },
        sys.stdout,
    )
    print()


def tab_host(_args):
    # Chromium native messaging: 4-byte native-order length, then JSON, both ways.
    while header := sys.stdin.buffer.read(4):
        report = json.loads(sys.stdin.buffer.read(int.from_bytes(header, sys.byteorder)))
        sent = send_control("tab " + json.dumps({"url": report.get("url"), "title": report.get("title")})) == 0
        reply = json.dumps({"ok": sent}).encode()
        sys.stdout.buffer.write(len(reply).to_bytes(4, sys.byteorder) + reply)
        sys.stdout.buffer.flush()
    return 0


def main():
    parser = argparse.ArgumentParser(prog="window-time", description="Time spent per focused window.")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("watch", help="run the tracker").set_defaults(func=watch)
    report_parser = commands.add_parser("report", help="totals per window, app or site")
    report_parser.add_argument("since", nargs="?", default="today")
    report_parser.add_argument("--by", choices=["window", "app", "site"], default="window")
    report_parser.add_argument("--min", type=float, default=MIN_SPAN_SECONDS, help="skip shorter stretches (seconds)")
    report_parser.set_defaults(func=report)
    log_parser = commands.add_parser("log", help="focus timeline")
    log_parser.add_argument("since", nargs="?", default="today")
    log_parser.add_argument("--min", type=float, default=MIN_SPAN_SECONDS, help="skip shorter stretches (seconds)")
    log_parser.set_defaults(func=log)
    export_parser = commands.add_parser("export", help="spans and calls as JSON")
    export_parser.add_argument("since", nargs="?", default="today")
    export_parser.add_argument("--until", help="end of the range (same formats as SINCE; default now)")
    export_parser.add_argument("--min", type=float, default=0, help="skip shorter stretches (seconds)")
    export_parser.set_defaults(func=export)
    idle_parser = commands.add_parser("idle", help="input stopped SECONDS ago")
    idle_parser.add_argument("seconds", type=float)
    idle_parser.set_defaults(func=lambda a: send_control(f"idle {a.seconds}"))
    commands.add_parser("active", help="input is back").set_defaults(func=lambda a: send_control("active"))
    # Chromium appends the caller's origin (and on some builds a window id) to the command line.
    tab_parser = commands.add_parser("tab", help="Chromium native-messaging host for the extension")
    tab_parser.add_argument("origin", nargs="*")
    tab_parser.set_defaults(func=tab_host)
    args = parser.parse_args()
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
