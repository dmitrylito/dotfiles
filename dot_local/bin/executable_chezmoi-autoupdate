#!/usr/bin/env bash
# chezmoi-autoupdate — keep this machine's dotfiles current without blocking the shell.
#
# Usage:
#   chezmoi-autoupdate           throttled; no-op if it already ran within MAX_AGE
#   chezmoi-autoupdate --local   synchronous local-only apply; no network
#   chezmoi-autoupdate --force   ignore the throttle
#   chezmoi-autoupdate --status  print the last run's outcome and exit
#
# Invoked from ~/.zshrc on interactive shell start, twice: once as --local
# (synchronous, applies whatever a previous run pulled) and once throttled
# (detached, does the network). The split is deliberate — a bare `git pull` costs
# ~700ms of round trip even with nothing to fetch, and hangs unbounded when the
# network is down, so nothing touching the network may sit in the shell's path.
#
# --local skips the apply entirely when the source commit it last applied is still
# HEAD. A no-op `chezmoi apply` is not cheap here: chezmoi must execute all six
# modify_ scripts to compute their targets, which costs ~165ms — most of it the
# Codex config merge. The commit marker turns the common case into two reads.
#
# Deliberately runs `apply --exclude scripts`: onchange scripts can install vendor
# units or restart user services and should only run during an intentional full
# apply. Package reconciliation is separate and is never invoked by Chezmoi.
# This helper pulls and applies committed configuration but never commits or pushes.
#
# Bails out of the *apply* silently when: the source tree is dirty, the pull is not a
# fast-forward, another run holds the lock, or the machine is offline. Outcome of every
# run is written to $LOG (one line), which is what --status reads.
#
# Serialised so simultaneous shell starts cannot race the repository or state file.

set -uo pipefail

MAX_AGE=${CHEZMOI_AUTOUPDATE_MAX_AGE:-14400}   # seconds; 4h
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}
STAMP="$CACHE_DIR/chezmoi-autoupdate.stamp"
APPLIED="$CACHE_DIR/chezmoi-autoupdate.applied"
LOG="$CACHE_DIR/chezmoi-autoupdate.log"
LOCK="${TMPDIR:-/tmp}/chezmoi-git-$(id -u).lock"

# Hard bounds on every apply, so no failure mode can ever wedge a shell or the
# lock. `timeout` is coreutils-only, so degrade to unbounded where it is absent.
TIMEOUT_LOCAL=${CHEZMOI_AUTOUPDATE_TIMEOUT:-10}
TIMEOUT_BG=${CHEZMOI_AUTOUPDATE_TIMEOUT_BG:-300}
if command -v timeout >/dev/null 2>&1; then
    APPLY_TIMEOUT="timeout $TIMEOUT_LOCAL"
    BG_TIMEOUT="timeout $TIMEOUT_BG"
else
    APPLY_TIMEOUT=""
    BG_TIMEOUT=""
fi

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >"$LOG"; }

record_applied() { printf '%s\t%s\n' "$1" "$2" >"$APPLIED" 2>/dev/null || true; }

case "${1:-}" in
    --status) [ -r "$LOG" ] && cat "$LOG" || echo "chezmoi-autoupdate: never run"; exit 0 ;;
    --local)  LOCAL=1; FORCE=0 ;;
    --force)  LOCAL=0; FORCE=1 ;;
    "")       LOCAL=0; FORCE=0 ;;
    *)        echo "chezmoi-autoupdate: unknown option: $1" >&2; exit 2 ;;
esac

command -v chezmoi >/dev/null 2>&1 || exit 0
mkdir -p "$CACHE_DIR"

# --local is the synchronous half: apply what an earlier background run already
# pulled. No network, so it costs ~20ms and belongs in the shell's critical path —
# a change fetched an hour ago lands on the next shell instead of waiting out the
# throttle. Safe to rewrite ~/.zshrc while zsh is sourcing it: chezmoi replaces
# targets by atomic rename, so the running shell keeps reading the old inode.
# Non-blocking lock, or a concurrent background apply would stall shell startup on
# chezmoi's persistent-state lock.
if [ "${LOCAL:-0}" -eq 1 ]; then
    # --no-tty is load-bearing. A target that drifted makes chezmoi ask
    # "<path> has changed since chezmoi last wrote it?", and it opens /dev/tty
    # directly to do it — redirecting stdin alone does NOT stop that. With stdout
    # swallowed the prompt is invisible, so it waits forever in the shell's
    # critical path holding chezmoi's state lock, and every later run then bails
    # silently on `flock -n`: applies just stop landing. --no-tty sends the prompt
    # to stdin instead, which is /dev/null, so it fails fast. timeout is the second
    # belt; the captured stderr is what makes the next failure diagnosable.
    # Deliberately NOT --force: that would silently overwrite whatever drifted.
    marker_src=''
    marker_head=''
    [ -r "$APPLIED" ] && IFS=$'\t' read -r marker_src marker_head <"$APPLIED"

    # The marker's own source path is trusted rather than re-derived: `chezmoi
    # source-path` is a second chezmoi process. A re-init that moves the source
    # invalidates the marker only until the next apply writes a new one.
    if [ -n "$marker_head" ] && [ -n "$marker_src" ] &&
       [ "$marker_head" = "$(git -C "$marker_src" rev-parse HEAD 2>/dev/null)" ]; then
        exit 0
    fi

    apply_local() {
        local src head rc err
        src=$(chezmoi source-path 2>/dev/null) || return
        git -C "$src" diff --quiet HEAD 2>/dev/null || return
        head=$(git -C "$src" rev-parse HEAD 2>/dev/null)
        err=$($APPLY_TIMEOUT chezmoi apply --no-tty --exclude scripts 2>&1 >/dev/null </dev/null)
        rc=$?
        if [ "$rc" -eq 0 ]; then
            record_applied "$src" "$head"
            return
        fi
        [ "$rc" -eq 124 ] && err="timed out after ${TIMEOUT_LOCAL}s"
        log "failed: local apply returned $rc${err:+ - ${err##*$'\n'}}"
    }
    if command -v flock >/dev/null 2>&1; then
        ( flock -n 9 || exit 0; apply_local ) 9>"$LOCK"
    else
        apply_local
    fi
    exit 0
fi

# -mmin is supported by both GNU and BSD find, unlike `stat` format flags.
if [ "$FORCE" -eq 0 ] && [ -f "$STAMP" ] &&
   [ -z "$(find "$STAMP" -mmin "+$((MAX_AGE / 60))" 2>/dev/null)" ]; then
    exit 0
fi

run() {
    # Let the shell finish sourcing its rc files before apply can rewrite them.
    sleep 3

    : >"$STAMP"

    local src rc
    src=$(chezmoi source-path 2>/dev/null) || { log "skipped: no source path"; return; }

    if ! git -C "$src" diff --quiet HEAD 2>/dev/null; then
        log "skipped: source has uncommitted changes"
        return
    fi

    if ! git -C "$src" pull --ff-only --quiet >/dev/null 2>&1; then
        log "skipped: pull failed (offline, or not a fast-forward)"
        return
    fi

    # Same reasoning as apply_local (see --no-tty there): a wedged background apply
    # holds the lock and silently starves every --local run. Longer bound; it is
    # off the shell's critical path.
    $BG_TIMEOUT chezmoi apply --no-tty --exclude scripts >/dev/null 2>&1 </dev/null
    rc=$?

    if [ "$rc" -eq 0 ]; then
        log "ok: applied $(git -C "$src" rev-parse --short HEAD)"
    elif [ "$rc" -eq 124 ]; then
        log "failed: apply timed out after ${TIMEOUT_BG}s"
    else
        log "failed: chezmoi apply returned $rc"
    fi
}

# Detach stdio too, or the background child holds the caller's pipe open for its
# whole run — `zsh -ic ... | foo` would block on it.
# flock is Linux-only; on macOS just run unserialised.
if command -v flock >/dev/null 2>&1; then
    ( flock -n 9 || exit 0; run ) 9>"$LOCK" >/dev/null 2>&1 </dev/null &
else
    ( run ) >/dev/null 2>&1 </dev/null &
fi

disown 2>/dev/null || true
exit 0
