#!/bin/bash
#
# work-mode — open the "work" apps and place them predictably.
#
#   ws 1 : work browser (chromium, "Work" profile)
#   ws 2 : Dialpad over FC Chat | FC Gmail
#   ws 3 : Linear | FC Tasks
#   scratchpad : Spotify
#
# Every app is its ~/.local/share/applications entry, launched through uwsm-app
# exactly as the SUPER+SPACE launcher would launch it. Nothing about an app is
# repeated here: the profile and the URL live in the entry's Exec line (which goes
# through ~/.local/bin/chromium-profile-launch), so editing the entry changes what
# work-mode opens, and the window it opens is the one the launcher already knows.
# Only the workspace and the layout below are this script's own.
#
# A layout is columns left to right, separated by "|", each holding one or more
# entries stacked top to bottom, separated by ",". Splits are even unless a width
# fraction is given. Every run re-applies the whole thing, whether or not anything
# was launched: a window already open on the wrong workspace is moved, and a
# workspace whose tree drifted is rebuilt. A layout already correct is left alone,
# because the churn of rebuilding it is visible.
#
# Nothing reads the workspace the script was invoked from, so it can be run from
# any workspace; the focused window is restored at the end.
#
# Launching is a separate phase from placing, so the cold starts overlap instead
# of running end to end. Ordering is only enforced WITHIN a chromium profile: the
# first process for a profile directory becomes its browser process and every
# later window of that profile is a forwarded command line, so the entry that
# opens a plain browser window goes first and is waited for. Separate profiles
# share nothing and start in parallel. Spotify reaches its scratchpad through a
# silent window rule in chezmoi.lua, so it never flashes over the foreground.
#
# Waiting is driven by Hyprland's event socket rather than by polling: every
# dispatch that has an event confirming it (a move, a focus) is waited on instead
# of slept through, so the script runs at the speed Hyprland actually works at.
# Addresses arrive from the socket without their "0x", hence the ${addr#0x} below.
#
# Device-agnostic by construction — nothing machine-specific is hardcoded:
#   * Chromium numbers profile DIRECTORIES in creation order, so "Profile 3" is a
#     different account on another machine. chromium-profile-launch resolves a
#     profile's display name to its directory out of Local State.
#   * The WM_CLASS of an Omarchy web app is derived from the URL plus that resolved
#     directory (chrome-<host>__<path>-<Profile_Dir>), so URL and class cannot drift.
#   * Widths are fractions of the row, turned into pixels from the live window
#     sizes, so no monitor resolution is baked in.
# Still device-dependent: which monitor each workspace lives on — that is
# workspaces.lua (nwg-displays output, per-device and chezmoi-ignored).
#
# Hyprland 0.56 parses its config in Lua, which changed how a script drives it:
#   * `hyprctl keyword ...` is refused outright ("keyword can't work with
#     non-legacy parsers"), so transient class-matched windowrules are gone, and
#     `hl.window_rule` can be added at runtime but never removed.
#   * `hyprctl dispatch` arguments are now a Lua expression:
#     `hyprctl dispatch 'hl.dsp.window.move({ workspace = "4" })'`.
#   * dwindle's splitratio dispatcher takes a delta only ("exact" is refused), so
#     widths are set with hl.dsp.window.resize({ exact = true, ... }) instead.
#   * There is no dispatcher that reorders a dwindle tree and no preselect, so a
#     layout is rebuilt by re-inserting windows one at a time (see rebuild).

set -uo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

LAUNCHER="$HOME/.local/bin/chromium-profile-launch"
ENTRY_DIRS=("$HOME/.local/share/applications" /usr/share/applications)

# <desktop entry>|<workspace>|<class regex, only where it cannot be derived>
APPS=(
  'spotify.desktop|special:spotify|^spotify$'
  'FC Chat.desktop|2|'
  'FC Tasks.desktop|3|'
  'DL-Chrome-Work.desktop|1|'
  'FC-Dialpad.desktop|2|'
  'FC Gmail.desktop|2|'
  'Linear.desktop|3|'
)

# Columns "|" left to right, entries "," stacked top to bottom within a column.
LAYOUT_2='FC-Dialpad.desktop,FC Chat.desktop | FC Gmail.desktop'
WIDTHS_2=(0.556)
LAYOUT_3='Linear.desktop | FC Tasks.desktop'
WIDTHS_3=()

BROWSER_CLASS='^chromium$'

# Rebuilding a layout parks windows here first. Never displayed.
STAGE_WS=90

# Recover the Hyprland instance signature when launched from a bare .desktop env.
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  sig_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"
  HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$sig_dir" 2>/dev/null | head -1)"
  export HYPRLAND_INSTANCE_SIGNATURE
fi

log() { printf '[work-mode] %s\n' "$*" >&2; }

# ---------------------------------------------------------------- event socket

EVENT_LOG=""
EVENT_PID=""

events_stop() {
  [[ -n "$EVENT_PID" ]] && kill "$EVENT_PID" 2>/dev/null
  [[ -n "$EVENT_LOG" ]] && rm -f "$EVENT_LOG"
}
trap events_stop EXIT

events_start() {
  local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
  command -v socat >/dev/null || { log "WARN  no socat; falling back to fixed waits"; return 1; }
  [[ -S "$sock" ]] || { log "WARN  no event socket; falling back to fixed waits"; return 1; }

  EVENT_LOG="$(mktemp -t work-mode-events.XXXXXX)"
  socat -u "UNIX-CONNECT:$sock" - >"$EVENT_LOG" 2>/dev/null &
  EVENT_PID=$!
}

# A line number to wait from. Taken BEFORE the dispatch, so an event that lands
# between the dispatch and the read is still seen.
event_mark() {
  [[ -n "$EVENT_LOG" ]] && wc -l <"$EVENT_LOG" || echo 0
}

# await <mark> <extended regex> <timeout seconds> — true once a matching event
# arrives. Without an event socket this is the fixed wait it replaced.
await() {
  local mark="$1" re="$2" timeout="$3" line
  # Without an event socket there is nothing to wait on, so fall back to a short
  # fixed pause rather than burning the whole timeout.
  [[ -n "$EVENT_LOG" ]] || { sleep 0.3; return 0; }

  while IFS= read -r line; do
    [[ "$line" =~ $re ]] && return 0
  done < <(timeout "$timeout" tail -n "+$((mark + 1))" -f "$EVENT_LOG" 2>/dev/null)
  return 1
}

dispatch() {
  local out
  out="$(hyprctl dispatch "$1" 2>&1 | tail -1)"
  [[ "$out" == "ok" ]] && return 0
  log "WARN  dispatch rejected: $1 -> $out"
  return 1
}

# ------------------------------------------------------------- desktop entries

entry_path() {
  local d
  for d in "${ENTRY_DIRS[@]}"; do
    [[ -r "$d/$1" ]] && { printf '%s\n' "$d/$1"; return 0; }
  done
  return 1
}

entry_field() {
  sed -n "/^\\[Desktop Entry\\]/,/^\\[/{ /^$2=/{ s/^$2=//p; q; } }" "$1"
}

# The class Chromium gives an --app window: host, then "__", then the path with
# "/" -> "_", then the profile directory with spaces -> "_".
webapp_class() {
  local p="${1#*://}"
  p="${p%%#*}"
  p="${p/\//__}"
  printf 'chrome-%s-%s\n' "${p//\//_}" "${2// /_}"
}

# The class only ever holds [A-Za-z0-9._-], so "." is the sole regex metacharacter.
anchored_re() {
  printf '^%s$\n' "${1//./\\.}"
}

# ------------------------------------------------------------- window geometry

addr_of() {
  hyprctl clients -j \
    | jq -r --arg c "$1" 'first(.[] | select(.class | test($c)) | .address) // empty'
}

# The workspace a window is on, as the same string a workspace argument takes
# ("3", "special:spotify").
ws_of() {
  hyprctl clients -j \
    | jq -r --arg a "$1" 'first(.[] | select(.address == $a) | .workspace.name) // empty'
}

# geom <addr> -> "x y w h"
geom() {
  hyprctl clients -j | jq -r --arg a "$1" \
    'first(.[] | select(.address == $a) | "\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])") // empty'
}

# ------------------------------------------------------------------- placement

# place <addr> <workspace> <label> — put a window on its workspace. hyprctl answers
# "ok" for a dispatch that matched nothing, so the landing workspace is read back
# rather than trusted.
place() {
  local addr="$1" ws="$2" label="$3" mark
  [[ -n "$addr" ]] || return 1
  [[ "$(ws_of "$addr")" == "$ws" ]] && return 0

  mark="$(event_mark)"
  dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, window = \"address:$addr\" })"
  await "$mark" "^movewindowv2>>${addr#0x}," 2

  if [[ "$(ws_of "$addr")" == "$ws" ]]; then
    log "move  $label -> workspace $ws"
    return 0
  fi
  log "WARN  $label stayed on workspace $(ws_of "$addr"), wanted $ws"
  return 1
}

move_to() {
  local addr="$1" ws="$2" mark
  mark="$(event_mark)"
  dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, window = \"address:$addr\" })"
  await "$mark" "^movewindowv2>>${addr#0x}," 2
}

focus_window() {
  local addr="$1" mark
  mark="$(event_mark)"
  dispatch "hl.dsp.focus({ window = \"address:$addr\" })"
  await "$mark" "^activewindowv2>>${addr#0x}$" 2
}

# Wait for a window of this class to exist. Driven by openwindow events, but the
# client list is what answers: a class read off the event can lag what Hyprland
# ends up matching rules against.
wait_for() {
  local re="$1" deadline=$((SECONDS + 30)) addr mark

  while :; do
    addr="$(addr_of "$re")"
    [[ -n "$addr" ]] && { printf '%s\n' "$addr"; return 0; }
    ((SECONDS >= deadline)) && return 1

    mark="$(event_mark)"
    await "$mark" '^openwindow>>' 2
  done
}

# ---------------------------------------------------------------------- layout

# set_width <addr> <fraction> <sibling-addr>... — give <addr> that fraction of the
# width it and its siblings currently occupy. Pixels, not a split ratio: dwindle's
# splitratio dispatcher only accepts a delta, and the width is read live so nothing
# resolution-specific is stored.
set_width() {
  local addr="$1" frac="$2"; shift 2
  local total=0 a x y w h

  for a in "$addr" "$@"; do
    read -r x y w h <<<"$(geom "$a")"
    [[ -n "$w" ]] || { log "WARN  set_width: window $a is gone"; return 1; }
    total=$((total + w))
  done

  read -r x y w h <<<"$(geom "$addr")"
  w="$(awk -v t="$total" -v f="$frac" 'BEGIN { printf "%d", t * f + 0.5 }')"
  dispatch "hl.dsp.window.resize({ x = $w, y = $h, exact = true, window = \"address:$addr\" })"
}

# insert <anchor> <addr> <h|v> — bring a parked window back beside or below the
# anchor. force_split=2 always drops it right/bottom of the focused window, and
# preserve_split=true makes it inherit the parent's axis; whichever of the two
# wins, the result is measured and corrected with togglesplit rather than assumed.
insert() {
  local anchor="$1" addr="$2" dir="$3" ws="$4"
  local ax ay aw ah nx ny nw nh wrong=0

  focus_window "$anchor"
  move_to "$addr" "$ws"

  read -r ax ay aw ah <<<"$(geom "$anchor")"
  read -r nx ny nw nh <<<"$(geom "$addr")"
  [[ -n "$nx" && -n "$ax" ]] || return 1

  case "$dir" in
    h) ((ny > ay)) && wrong=1 ;;
    v) ((nx > ax)) && wrong=1 ;;
  esac

  if ((wrong)); then
    focus_window "$addr"
    dispatch 'hl.dsp.layout("togglesplit")'
    # Nothing is emitted for a layout change, so this one wait stays a sleep.
    sleep 0.25
  fi
}

# layout_is_ok <columns...> where each column is a newline-separated address list.
layout_is_ok() {
  local col prev_x="" first=1 a x y w h col_x col_w prev_y
  for col in "$@"; do
    col_x=""; col_w=""; prev_y=""
    while IFS= read -r a; do
      [[ -n "$a" ]] || continue
      read -r x y w h <<<"$(geom "$a")"
      [[ -n "$x" ]] || return 1
      if [[ -z "$col_x" ]]; then
        col_x="$x"; col_w="$w"
      else
        [[ "$x" == "$col_x" && "$w" == "$col_w" && "$y" -gt "$prev_y" ]] || return 1
      fi
      prev_y="$y"
    done <<<"$col"

    if ((first)); then
      first=0
    else
      [[ "$col_x" -gt "$prev_x" ]] || return 1
    fi
    prev_x="$col_x"
  done
  return 0
}

# rebuild <workspace> <column>... — force the workspace into the given columns.
# The head of every column is inserted first, left to right, so that a column with
# several windows becomes the sibling of the whole next column rather than of its
# top window; only then is each column stacked. Going the other way would need
# preselect, which 0.56's Lua dispatcher set does not have.
rebuild() {
  local ws="$1"; shift
  local cols=("$@") col a heads=() rest=() first="" prev head

  for col in "${cols[@]}"; do
    head=""
    while IFS= read -r a; do
      [[ -n "$a" ]] || continue
      if [[ -z "$head" ]]; then head="$a"; heads+=("$a")
      else rest+=("$head|$a"); head="$a"
      fi
    done <<<"$col"
  done

  first="${heads[0]}"
  for a in "${heads[@]:1}" ; do move_to "$a" "$STAGE_WS"; done
  for a in "${rest[@]}"; do move_to "${a#*|}" "$STAGE_WS"; done

  prev="$first"
  for a in "${heads[@]:1}"; do
    insert "$prev" "$a" h "$ws"
    prev="$a"
  done
  for a in "${rest[@]}"; do
    insert "${a%%|*}" "${a#*|}" v "$ws"
  done
}

# apply_layout <workspace> <layout string> <width fraction>...
apply_layout() {
  local ws="$1" spec="$2"; shift 2
  local fracs=("$@") cols=() heads=() parts=() members=() part entry addrs a i

  IFS='|' read -r -a parts <<<"$spec"
  for part in "${parts[@]}"; do
    addrs=""
    IFS=',' read -r -a members <<<"$part"
    for entry in "${members[@]}"; do
      entry="${entry#"${entry%%[![:space:]]*}"}"
      entry="${entry%"${entry##*[![:space:]]}"}"
      a="${ADDR[$entry]:-}"
      [[ -n "$a" ]] || { log "WARN  workspace $ws layout skipped: $entry is not open"; return 0; }
      addrs+="${addrs:+$'\n'}$a"
    done
    cols+=("$addrs")
    heads+=("${addrs%%$'\n'*}")
  done

  if ! layout_is_ok "${cols[@]}"; then
    log "fix   workspace $ws layout"
    rebuild "$ws" "${cols[@]}"
  fi

  for i in "${!fracs[@]}"; do
    [[ -n "${fracs[$i]}" ]] || continue
    set_width "${heads[$i]}" "${fracs[$i]}" "${heads[@]:$i+1}"
  done
}

# ------------------------------------------------------------------------ main

declare -A E_FILE E_LABEL E_WS E_CLASS E_PROFILE E_URL ADDR
ENTRIES=()

# Read every entry up front: its label, the profile and URL its Exec line carries,
# and the window class those two imply.
for spec in "${APPS[@]}"; do
  IFS='|' read -r name ws class_override <<<"$spec"

  file="$(entry_path "$name")" || { log "WARN  no desktop entry named \"$name\""; continue; }
  exec_line="$(entry_field "$file" Exec)"

  profile=""; url=""
  if [[ "$exec_line" == *chromium-profile-launch* ]]; then
    profile="$(sed -n 's/.*chromium-profile-launch "\([^"]*\)".*/\1/p' <<<"$exec_line")"
    url="$(sed -n 's/.*chromium-profile-launch "[^"]*" webapp "\([^"]*\)".*/\1/p' <<<"$exec_line")"
  fi

  if [[ -n "$class_override" ]]; then
    class="$class_override"
  elif [[ -n "$url" ]]; then
    dir="$("$LAUNCHER" "$profile" resolve)" \
      || { log "WARN  skipping $name: cannot resolve profile \"$profile\""; continue; }
    class="$(anchored_re "$(webapp_class "$url" "$dir")")"
  elif [[ -n "$profile" ]]; then
    class="$BROWSER_CLASS"
  else
    log "WARN  skipping $name: no class, and its Exec line is not a chromium web app"
    continue
  fi

  ENTRIES+=("$name")
  E_FILE["$name"]="$file"
  E_LABEL["$name"]="$(entry_field "$file" Name)"
  E_WS["$name"]="$ws"
  E_CLASS["$name"]="$class"
  E_PROFILE["$name"]="$profile"
  E_URL["$name"]="$url"
done

# spawn <entry> — launch it the way the application launcher would, and only if it
# is not already open.
spawn() {
  local name="$1"

  if [[ -n "$(addr_of "${E_CLASS[$name]}")" ]]; then
    log "skip  ${E_LABEL[$name]} (already open)"
    return 0
  fi

  log "open  ${E_LABEL[$name]}"
  setsid -f uwsm-app -- "${E_FILE[$name]}" >/dev/null 2>&1
}

events_start
FOCUS_ADDR="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')"

# The entry that opens a plain browser window owns its profile's process, so it is
# launched before that profile's web apps and waited for.
OWNER=""
for name in "${ENTRIES[@]}"; do
  [[ -n "${E_PROFILE[$name]}" && -z "${E_URL[$name]}" ]] && { OWNER="$name"; break; }
done
OWNER_PROFILE="${OWNER:+${E_PROFILE[$OWNER]}}"

for name in "${ENTRIES[@]}"; do
  [[ "$name" == "$OWNER" ]] && continue
  [[ -n "$OWNER_PROFILE" && "${E_PROFILE[$name]}" == "$OWNER_PROFILE" ]] && continue
  spawn "$name"
done

if [[ -n "$OWNER" ]]; then
  spawn "$OWNER"
  wait_for "${E_CLASS[$OWNER]}" >/dev/null || log "WARN  ${E_LABEL[$OWNER]} window never appeared"
  for name in "${ENTRIES[@]}"; do
    [[ "$name" != "$OWNER" && "${E_PROFILE[$name]}" == "$OWNER_PROFILE" ]] && spawn "$name"
  done
fi

for name in "${ENTRIES[@]}"; do
  addr="$(wait_for "${E_CLASS[$name]}")" \
    || { log "WARN  ${E_LABEL[$name]} window never appeared"; continue; }
  ADDR["$name"]="$addr"
  place "$addr" "${E_WS[$name]}" "${E_LABEL[$name]}"
done

apply_layout 2 "$LAYOUT_2" ${WIDTHS_2[@]+"${WIDTHS_2[@]}"}
apply_layout 3 "$LAYOUT_3" ${WIDTHS_3[@]+"${WIDTHS_3[@]}"}

[[ -n "$FOCUS_ADDR" ]] && focus_window "$FOCUS_ADDR"

log "done"
