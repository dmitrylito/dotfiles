#!/bin/bash
# omarchy-shell-reaper — SIGKILL an Omarchy shell that hangs after being told to exit.
#
# `omarchy restart shell` (also the "Restarting shell" step of `omarchy update`)
# asks the running quickshell to exit over IPC and waits for it to go before
# launching the new one. On fcoffice the old shell's teardown grows with its
# uptime (0.3s at 1h, 5s at 6h, 50s at 21h, 14min at 44h), so the restart
# stalls. This follows the shell's journal tag; when a shell logs "Exiting due
# to IPC request" and is still alive OMARCHY_SHELL_REAP_GRACE seconds later, it
# logs per-thread CPU over the grace window (evidence for the root cause), stops
# the omarchy-launch-shell supervisor so it does not relaunch, and SIGKILLs it.
#
# Run by omarchy-shell-reaper.service; logs under journal tag omarchy-shell-reaper.
# Env:
#   OMARCHY_SHELL_REAP_GRACE  seconds to let teardown finish (default 5)
#   OMARCHY_SHELL_REAP_TAG    journal tag to follow (default omarchy-shell)

set -uo pipefail

grace="${OMARCHY_SHELL_REAP_GRACE:-5}"
tag="${OMARCHY_SHELL_REAP_TAG:-omarchy-shell}"

log() { logger -t omarchy-shell-reaper -- "$*"; }

start_time() { awk '{ sub(/^.*\) /, ""); print $20 }' "/proc/$1/stat" 2>/dev/null; }

thread_cpu() {
  local task stat
  for task in /proc/"$1"/task/*; do
    stat=$(<"$task/stat") 2>/dev/null || continue
    stat=${stat##*) }
    read -r -a f <<<"$stat"
    printf '%s %s %s %s\n' "${task##*/}" "${f[0]}" "$((f[11] + f[12]))" "$(tr ' ' _ <"$task/comm" 2>/dev/null)"
  done
}

reap() {
  local pid=$1 started before after elapsed=0 parent
  [[ $(readlink "/proc/$pid/exe" 2>/dev/null) == */quickshell ]] || return
  started=$(start_time "$pid")
  before=$(thread_cpu "$pid")

  while (( elapsed < grace * 10 )); do
    sleep 0.1
    [[ $(start_time "$pid") == "$started" ]] || return
    (( elapsed++ ))
  done

  after=$(thread_cpu "$pid")
  log "shell $pid still tearing down ${grace}s after its IPC exit; rss=$(awk '/VmRSS/ { print $2 $3 }' "/proc/$pid/status") threads=$(ls "/proc/$pid/task" | wc -l)"
  # Busiest threads over the grace window: tid, state, cpu ticks, name.
  join <(sort <<<"$before") <(sort <<<"$after") |
    awk '{ print $1, $5, $6 - $3, $7 }' | sort -k3 -nr | head -5 |
    while read -r line; do log "  thread $line"; done

  [[ $(start_time "$pid") == "$started" ]] || return
  parent=$(ps -o ppid= -p "$pid" | tr -d ' ')
  if [[ -n $parent ]] && grep -q omarchy-launch-shell "/proc/$parent/cmdline" 2>/dev/null; then
    kill -TERM "$parent" 2>/dev/null
  fi
  kill -KILL "$pid" 2>/dev/null && log "killed shell $pid"
}

journalctl --user -f -n 0 -t "$tag" -o json --output-fields=_PID,MESSAGE |
  jq --unbuffered -r 'select((if (.MESSAGE|type) == "array" then (.MESSAGE|implode) else .MESSAGE end) | test("Exiting due to IPC request")) | ._PID' |
  while read -r pid; do
    reap "$pid" &
  done
