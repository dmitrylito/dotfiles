#!/usr/bin/env bash
# Open the default coding agent (omarchy-agent, i.e. claude in ~/Work) inside a
# dedicated herdr session, in a terminal window. SUPER+S launches this when the
# scratchpad is empty (see qconsole_refit in ~/.config/hypr/bindings.lua).
#
# Usage: herdr-agent [--inline]   --inline attaches in the current terminal
# Env:   HERDR_AGENT_SESSION       herdr session name (default: scratchpad)
#
# The session outlives the window: closing it detaches, and the next launch
# re-attaches to the same agent. A fresh session (or one whose workspaces were
# all closed) gets one "Claude" workspace in ~/Work running omarchy-agent.
set -euo pipefail

session="${HERDR_AGENT_SESSION:-scratchpad}"
h() { herdr --session "$session" "$@"; }

if ! h workspace list >/dev/null 2>&1; then
  setsid -f herdr --session "$session" server >/dev/null 2>&1 </dev/null
  for _ in $(seq 50); do
    h workspace list >/dev/null 2>&1 && break
    sleep 0.1
  done
fi

if [[ $(h workspace list | jq '.result.workspaces | length') == 0 ]]; then
  pane=$(h workspace create --cwd "$HOME/Work" --label Claude --focus | jq -r '.result.root_pane.pane_id')
  h pane run "$pane" omarchy-agent --inline >/dev/null
fi

# Only this client starts with the sidebar collapsed: it reads a copy of the real
# config (so keys and theme still match) via HERDR_CONFIG_PATH, which the server
# never sees. prefix+b still toggles it. Env goes in the command because
# uwsm-app does not pass this process's environment to the terminal.
config="${HERDR_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml}"
client_config="${XDG_RUNTIME_DIR:-/tmp}/herdr-agent/config.toml"
mkdir -p "${client_config%/*}"
awk '
  /^[[:space:]]*sidebar_start_collapsed[[:space:]]*=/ { next }
  { print }
  /^\[ui\][[:space:]]*$/ { print "sidebar_start_collapsed = true"; ui = 1 }
  END { if (!ui) print "\n[ui]\nsidebar_start_collapsed = true" }
' "$config" 2>/dev/null >"$client_config" || printf '[ui]\nsidebar_start_collapsed = true\n' >"$client_config"
client=(env "HERDR_CONFIG_PATH=$client_config" herdr --session "$session")

if [[ ${1:-} == --inline ]]; then
  exec "${client[@]}"
fi
exec omarchy-launch-tui --app-id=org.omarchy.agent "${client[@]}"
