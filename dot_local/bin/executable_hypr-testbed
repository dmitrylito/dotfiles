#!/bin/bash
#
# hypr-testbed — a throwaway Hyprland to test window placement against, so nothing
# under test ever touches the session you are working in.
#
#   hypr-testbed start [monitors]   start it (default 3 monitors), print its env
#   hypr-testbed env                print the same env again, for `eval "$(...)"`
#   hypr-testbed run <cmd...>       run a command against it
#   hypr-testbed status             is it up, and what is in it
#   hypr-testbed stop               kill it and clean up
#
# Typical use:
#   hypr-testbed start
#   eval "$(hypr-testbed env)"      # now hyprctl and launched apps target the testbed
#   foot --app-id=probe &           # appears in the testbed, not on your screen
#   hypr-testbed stop
#
# It runs nested: Hyprland's Wayland backend draws into one window in the host
# session, and the extra monitors are virtual outputs added at runtime. Aquamarine
# 0.15.1 has no headless-only backend (CBackend::create() fails with no
# WAYLAND_DISPLAY), so a host Wayland session is required — this cannot run over a
# bare SSH shell. The nested window is parked on PARK_WS and never focused.
#
# Layout settings are copied from the omarchy session so a layout that passes here
# behaves the same there. The workspace-to-monitor map mirrors the real one:
# ws 1 -> first monitor, ws 2 -> second, ws 3 and up -> third.
#
# Not isolated: anything that talks to an already-running singleton escapes into
# the host session. A chromium web app for a profile whose browser process is
# already running in the host session opens ITS window in the host session, not
# here. Test those with a throwaway --user-data-dir, or with stand-in windows
# (`foot --app-id=<the class>`).

set -uo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr-testbed"
STATE="$STATE_DIR/state"
CONFIG="$STATE_DIR/config.lua"
LOG="$STATE_DIR/hyprland.log"
PARK_WS="${HYPR_TESTBED_PARK_WS:-9}"

die() { printf 'hypr-testbed: %s\n' "$*" >&2; exit 1; }

# The host compositor, asked rather than assumed: the runtime directory keeps the
# signatures of dead sessions and some still hold a .socket.sock.
host_signature() {
  local sig
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl version >/dev/null 2>&1; then
    printf '%s\n' "$HYPRLAND_INSTANCE_SIGNATURE"
    return 0
  fi
  for sig in $(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null); do
    HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl version >/dev/null 2>&1 \
      && { printf '%s\n' "$sig"; return 0; }
  done
  return 1
}

# write_config <monitor count>. The nested compositor always names its own output
# WAYLAND-1 and the ones added at runtime HEADLESS-1, HEADLESS-2, ... so the rules
# can be written before those outputs exist; Hyprland applies each when it appears.
write_config() {
  local monitors="$1" n target

  cat > "$CONFIG" <<'LUA'
-- Generated by hypr-testbed. Layout settings mirror the omarchy session so that a
-- layout verified here behaves the same there; nothing else is loaded, so no bar,
-- no autostart and no keybinds come with it.
hl.config({
    general = { layout = "dwindle", gaps_in = 4, gaps_out = 8, border_size = 3 },
    dwindle = { force_split = 2, preserve_split = true, smart_split = false },
    misc = { disable_hyprland_logo = true, disable_splash_rendering = true },
})
LUA

  for n in $(seq 1 10); do
    if ((n == 1)); then target="WAYLAND-1"
    elif ((n < monitors)); then target="HEADLESS-$((n - 1))"
    else target="HEADLESS-$((monitors - 1))"
    fi
    ((monitors == 1)) && target="WAYLAND-1"
    printf 'hl.workspace_rule({ workspace = "%s", monitor = "%s" })\n' "$n" "$target" >> "$CONFIG"
  done
}

start() {
  local monitors="${1:-3}" host nested sig display i

  [[ -n "${WAYLAND_DISPLAY:-}" ]] || die "no WAYLAND_DISPLAY; a nested compositor needs a host Wayland session"
  command -v Hyprland >/dev/null || die "Hyprland is not installed"
  running && die "already running ($(sed -n 's/^SIG=//p' "$STATE")); stop it first"

  host="$(host_signature)" || die "no live Hyprland to nest inside"
  mkdir -p "$STATE_DIR"
  write_config "$monitors"

  # Hyprland picks the next free wayland-N for its own socket; which one it took is
  # only knowable by diffing, so the sockets present before it starts are recorded.
  local before after
  before="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" | grep -E '^wayland-[0-9]+$' | sort)"

  setsid -f env -u HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_NO_CRASHREPORTER=1 \
    Hyprland -c "$CONFIG" >"$LOG" 2>&1

  for ((i = 0; i < 100; i++)); do
    sleep 0.2
    for sig in $(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null); do
      [[ "$sig" == "$host" ]] && continue
      HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl version >/dev/null 2>&1 \
        && { nested="$sig"; break 2; }
    done
  done
  [[ -n "${nested:-}" ]] || { tail -5 "$LOG" >&2; die "the nested compositor never came up"; }

  after="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" | grep -E '^wayland-[0-9]+$' | sort)"
  display="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -1)"
  [[ -n "$display" ]] || die "cannot tell which wayland socket the testbed took"

  for ((i = 1; i < monitors; i++)); do
    HYPRLAND_INSTANCE_SIGNATURE="$nested" hyprctl output create headless >/dev/null
  done
  sleep 0.5

  local names=()
  mapfile -t names < <(HYPRLAND_INSTANCE_SIGNATURE="$nested" hyprctl monitors -j | jq -r '.[].name')

  park "$host" "$nested"

  printf 'SIG=%s\nDISPLAY=%s\nHOST=%s\n' "$nested" "$display" "$host" > "$STATE"
  printf 'hypr-testbed: up, %s monitors, nested window parked on host workspace %s\n' \
    "${#names[@]}" "$PARK_WS" >&2
  env_for_eval
}

# The nested compositor is a window in the host session; put it somewhere it is not
# in the way. It is never focused, so it never steals input.
park() {
  local host="$1" nested="$2" addr
  addr="$(HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl clients -j \
    | jq -r --arg d "$nested" 'first(.[] | select(.class == "aquamarine") | .address) // empty')"
  [[ -n "$addr" ]] || return 0
  HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl dispatch \
    "hl.dsp.window.move({ workspace = \"$PARK_WS\", follow = false, window = \"address:$addr\" })" >/dev/null
}

running() {
  [[ -r "$STATE" ]] || return 1
  local sig; sig="$(sed -n 's/^SIG=//p' "$STATE")"
  [[ -n "$sig" ]] && HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl version >/dev/null 2>&1
}

env_for_eval() {
  running || die "not running"
  printf 'export HYPRLAND_INSTANCE_SIGNATURE=%s\nexport WAYLAND_DISPLAY=%s\n' \
    "$(sed -n 's/^SIG=//p' "$STATE")" "$(sed -n 's/^DISPLAY=//p' "$STATE")"
}

stop() {
  [[ -r "$STATE" ]] || { printf 'hypr-testbed: not running\n' >&2; return 0; }
  pkill -f "Hyprland -c $CONFIG" 2>/dev/null
  rm -f "$STATE"
  printf 'hypr-testbed: stopped\n' >&2
}

case "${1:-}" in
  start)  shift; start "$@" ;;
  env)    env_for_eval ;;
  run)    shift; [[ $# -gt 0 ]] || die "run needs a command"
          running || die "not running"
          env HYPRLAND_INSTANCE_SIGNATURE="$(sed -n 's/^SIG=//p' "$STATE")" \
              WAYLAND_DISPLAY="$(sed -n 's/^DISPLAY=//p' "$STATE")" "$@" ;;
  status) if running; then
            sig="$(sed -n 's/^SIG=//p' "$STATE")"
            printf 'running: %s\n' "$sig"
            HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl monitors -j \
              | jq -r '.[] | "  monitor \(.name) \(.width)x\(.height) ws=\(.activeWorkspace.id)"'
            HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl clients -j \
              | jq -r '.[] | "  window  ws=\(.workspace.name) \(.class)"'
          else
            printf 'not running\n'
          fi ;;
  stop)   stop ;;
  *)      sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
