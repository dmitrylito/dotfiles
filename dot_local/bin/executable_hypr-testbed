#!/bin/bash
#
# hypr-testbed — a throwaway Hyprland to test window placement against, so nothing
# under test ever touches the session you are working in.
#
#   hypr-testbed start [--headless] [monitors]
#                                   start it (default 3 monitors), print its env
#   hypr-testbed env                print the same env again, for `eval "$(...)"`
#   hypr-testbed run <cmd...>       run a command against it
#   hypr-testbed screenshot [monitor|workspace] [file]
#                                   PNG of one monitor, never shown on your screen
#                                   (default: the focused one; prints the path)
#   hypr-testbed show               bring its screen up, to click around in it
#                                   (that screen is monitor 1 = workspace 1)
#   hypr-testbed hide               put it away again
#   hypr-testbed status             is it up, and what is in it
#   hypr-testbed stop               kill it and clean up
#
# Typical use:
#   hypr-testbed start
#   eval "$(hypr-testbed env)"      # now hyprctl and launched apps target the testbed
#   foot --app-id=probe &           # appears in the testbed, not on your screen
#   hypr-testbed stop
#
# It runs nested: Hyprland's Wayland backend needs one window in the host session to
# start, and the monitors under test are virtual outputs added at runtime. That
# window is kept but moved to a hidden scratchpad workspace, so a running testbed is
# out of the way without being gone — `show` brings it up whenever the testbed needs
# a pair of hands (signing Chromium in, clicking something), `hide` puts it back,
# and nothing in it is lost either way. Removing the window instead is a one-way
# door: `hyprctl output create wayland` answers ok and creates nothing.
#
# Screenshots: monitor 1 is that host window, and a hidden host window gets no
# frame callbacks, so the nested compositor never renders it and grim waits forever.
# The HEADLESS-n monitors render on their own clock and capture fine while hidden.
# `start --headless` makes every monitor headless (ws 1 -> HEADLESS-1, ...) by
# disabling WAYLAND-1 once the others exist; use it for anything that has to be
# looked at, a shell or bar under test included, since such a shell puts its
# first bar, and its IPC-opened popups, on monitor 1. `show` has nothing to show
# in that mode. Never `show` just to take a screenshot: it lands on the real screen.
#
# Set HYPR_TESTBED_VISIBLE=1 to park it on PARK_WS as an ordinary window instead.
# Aquamarine 0.15.1 has no headless-only backend (CBackend::create() fails with no
# WAYLAND_DISPLAY), so a host Wayland session is required: this cannot run over a
# bare SSH shell.
#
# Layout settings are copied from the omarchy session so a layout that passes here
# behaves the same there. The workspace-to-monitor map mirrors the real one:
# ws 1 -> first monitor, ws 2 -> second, ws 3 and up -> third.
#
# Chromium is handled: the testbed exports CHROMIUM_USER_DATA_DIR pointing at its
# own profile tree, which chromium-profile-launch passes to Chromium as
# --user-data-dir. Without that a launch is handed to the Chromium that already
# owns the real data dir and the window opens in the host session. The profile
# names are copied from the real Local State so a web app resolves to the same
# profile directory, and therefore to the same WM_CLASS, as it does for real.
#
# Anything else that talks to an already-running singleton still escapes the same
# way; a stand-in window (`foot --app-id=<the class>`) is the fallback.

set -uo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr-testbed"
# Chromium's data dir is a real profile tree, so it lives on disk rather than in
# the tmpfs runtime dir, and it is kept between runs so test logins survive.
CHROMIUM_DIR="${HYPR_TESTBED_CHROMIUM_DIR:-$HOME/.cache/hypr-testbed/chromium}"
STATE="$STATE_DIR/state"
CONFIG="$STATE_DIR/config.lua"
LOG="$STATE_DIR/hyprland.log"
PARK_WS="${HYPR_TESTBED_PARK_WS:-9}"
SCRATCH="${HYPR_TESTBED_SCRATCHPAD:-testbed}"

die() { printf 'hypr-testbed: %s\n' "$*" >&2; exit 1; }

# The host compositor, asked rather than assumed: the runtime directory keeps the
# signatures of dead sessions and some still hold a .socket.sock.
host_signature() {
  local sig
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl version >/dev/null 2>&1; then
    printf '%s\n' "$HYPRLAND_INSTANCE_SIGNATURE"
    return 0
  fi
  for sig in $(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null); do
    HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl version >/dev/null 2>&1 \
      && { printf '%s\n' "$sig"; return 0; }
  done
  return 1
}

# write_config <monitor count>. The nested compositor always names its own output
# WAYLAND-1 and the ones added at runtime HEADLESS-1, HEADLESS-2, ... so the rules
# can be written before those outputs exist; Hyprland applies each when it appears.
# Chromium numbers profile directories in creation order, so a fresh data dir would
# hand out different directories and every derived WM_CLASS would change. Seeding
# the name-to-directory map up front keeps the testbed's classes identical to the
# real session's. Only names are copied; nothing else from the real profile.
seed_chromium() {
  local real="$HOME/.config/chromium/Local State"

  mkdir -p "$CHROMIUM_DIR"
  [[ -e "$CHROMIUM_DIR/Local State" ]] && return 0
  [[ -r "$real" ]] || { printf 'hypr-testbed: no real Local State to copy profile names from\n' >&2; return 0; }

  jq '{ profile: { info_cache: (.profile.info_cache | with_entries(.value |= { name: .name, user_name: .user_name })) } }' \
    "$real" > "$CHROMIUM_DIR/Local State"
}

write_config() {
  local monitors="$1" headless="${2:-0}" n target

  cat > "$CONFIG" <<'LUA'
-- Generated by hypr-testbed. Layout settings mirror the omarchy session so that a
-- layout verified here behaves the same there; nothing else is loaded, so no bar,
-- no autostart and no keybinds come with it.
hl.config({
    general = { layout = "dwindle", gaps_in = 4, gaps_out = 8, border_size = 3 },
    dwindle = { force_split = 2, preserve_split = true, smart_split = false },
    misc = { disable_hyprland_logo = true, disable_splash_rendering = true },
})

-- The window the Wayland backend draws into is monitor 1, pinned to the same size
-- as the virtual ones so every monitor under test has identical geometry. It is
-- also the only monitor with a screen, so `hypr-testbed show` shows workspace 1.
hl.monitor({ output = "WAYLAND-1", mode = "1920x1080", position = "0x0", scale = 1 })
LUA

  # Without a rule Hyprland auto-scales a headless output to 2, which would make
  # the virtual monitors half the logical size of WAYLAND-1 and of the real ones.
  for n in $(seq 1 10); do
    printf 'hl.monitor({ output = "HEADLESS-%s", mode = "1920x1080", position = "auto", scale = 1 })\n' "$n" >> "$CONFIG"
  done

  for n in $(seq 1 10); do
    if ((headless)); then target="HEADLESS-$((n < monitors ? n : monitors))"
    elif ((n == 1)); then target="WAYLAND-1"
    elif ((n < monitors)); then target="HEADLESS-$((n - 1))"
    else target="HEADLESS-$((monitors - 1))"
    fi
    ((monitors == 1 && !headless)) && target="WAYLAND-1"
    printf 'hl.workspace_rule({ workspace = "%s", monitor = "%s" })\n' "$n" "$target" >> "$CONFIG"
  done
}

start() {
  local headless=0 host nested sig display i
  [[ "${1:-}" == --headless ]] && { headless=1; shift; }
  local monitors="${1:-3}"
  [[ "$monitors" =~ ^[1-9][0-9]*$ ]] || die "monitors must be a positive number"

  [[ -n "${WAYLAND_DISPLAY:-}" ]] || die "no WAYLAND_DISPLAY; a nested compositor needs a host Wayland session"
  command -v Hyprland >/dev/null || die "Hyprland is not installed"
  running && die "already running ($(sed -n 's/^SIG=//p' "$STATE")); stop it first"

  host="$(host_signature)" || die "no live Hyprland to nest inside"
  mkdir -p "$STATE_DIR"
  seed_chromium
  write_config "$monitors" "$headless"

  # Hyprland picks the next free wayland-N for its own socket; which one it took is
  # only knowable by diffing, so the sockets present before it starts are recorded.
  local before after
  before="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" | grep -E '^wayland-[0-9]+$' | sort)"

  setsid -f env -u HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_NO_CRASHREPORTER=1 \
    Hyprland -c "$CONFIG" >"$LOG" 2>&1

  for ((i = 0; i < 100; i++)); do
    sleep 0.2
    for sig in $(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null); do
      [[ "$sig" == "$host" ]] && continue
      HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl version >/dev/null 2>&1 \
        && { nested="$sig"; break 2; }
    done
  done
  [[ -n "${nested:-}" ]] || { tail -5 "$LOG" >&2; die "the nested compositor never came up"; }

  after="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" | grep -E '^wayland-[0-9]+$' | sort)"
  display="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -1)"
  [[ -n "$display" ]] || die "cannot tell which wayland socket the testbed took"

  for ((i = headless ? 0 : 1; i < monitors; i++)); do
    HYPRLAND_INSTANCE_SIGNATURE="$nested" hyprctl output create headless >/dev/null
  done
  sleep 0.5
  # Disabled, not removed: the backend window has to stay (see the header).
  ((headless)) && HYPRLAND_INSTANCE_SIGNATURE="$nested" \
    hyprctl eval 'hl.monitor({ output = "WAYLAND-1", disabled = true })' >/dev/null

  park "$host" "$nested"

  local names=()
  mapfile -t names < <(HYPRLAND_INSTANCE_SIGNATURE="$nested" hyprctl monitors -j \
    | jq -r --argjson h "$headless" '.[] | select($h == 0 or .name != "WAYLAND-1") | .name')

  printf 'SIG=%s\nDISPLAY=%s\nHOST=%s\nPID=%s\nHEADLESS=%s\n' "$nested" "$display" "$host" \
    "$(pgrep -f "^Hyprland -c $CONFIG$" | head -1)" "$headless" > "$STATE"
  if ((headless)); then
    printf 'hypr-testbed: up, %s headless monitors; "hypr-testbed screenshot" to look at one\n' "${#names[@]}" >&2
  else
    printf 'hypr-testbed: up, %s monitors, %s\n' "${#names[@]}" \
      "${HYPR_TESTBED_VISIBLE:+parked on host workspace $PARK_WS}${HYPR_TESTBED_VISIBLE:-hidden; \"hypr-testbed show\" to use it by hand}" >&2
  fi
  env_for_eval
}

# The nested compositor is a window in the host session; put it out of the way
# without closing it. It is never focused, so it never steals input.
park() {
  local host="$1" nested="$2" addr target
  addr="$(HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl clients -j \
    | jq -r 'first(.[] | select(.class == "aquamarine") | .address) // empty')"
  [[ -n "$addr" ]] || return 0

  target="special:$SCRATCH"
  [[ -n "${HYPR_TESTBED_VISIBLE:-}" ]] && target="$PARK_WS"

  HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl dispatch \
    "hl.dsp.window.move({ workspace = \"$target\", follow = false, window = \"address:$addr\" })" >/dev/null
}

# show/hide toggle the host scratchpad the nested window lives on. That window IS
# the testbed's monitor 1, so what it reveals is workspace 1, driven with a real
# keyboard and mouse like any other window — which is how Chromium gets signed in
# inside it. Workspaces on the virtual monitors have no screen; move a window to
# workspace 1 to see it.
reveal() {
  local want="$1" host shown
  running || die "not running"
  host="$(sed -n 's/^HOST=//p' "$STATE")"

  shown="$(HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl monitors -j \
    | jq -r --arg w "special:$SCRATCH" '[.[] | select(.specialWorkspace.name == $w)] | length')"

  if [[ "$want" == show && "$shown" == 0 ]] || [[ "$want" == hide && "$shown" != 0 ]]; then
    HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl dispatch \
      "hl.dsp.workspace.toggle_special(\"$SCRATCH\")" >/dev/null
  fi

  if [[ "$want" == show ]]; then
    local addr
    addr="$(HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl clients -j \
      | jq -r 'first(.[] | select(.class == "aquamarine") | .address) // empty')"
    [[ -n "$addr" ]] && HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl dispatch \
      "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
  fi
}

# screenshot [monitor|workspace] [file]. A workspace number resolves to the monitor
# showing it. Monitor 1 is refused while hidden rather than left to hang grim.
screenshot() {
  local target="${1:-}" file="${2:-}" sig monitors name host shown
  running || die "not running"
  sig="$(sed -n 's/^SIG=//p' "$STATE")"
  monitors="$(HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl monitors -j)"

  if [[ -z "$target" ]]; then
    name="$(jq -r 'first(.[] | select(.focused) | .name) // first(.[].name)' <<<"$monitors")"
  elif [[ "$target" =~ ^[0-9]+$ ]]; then
    name="$(jq -r --argjson ws "$target" 'first(.[] | select(.activeWorkspace.id == $ws) | .name) // empty' <<<"$monitors")"
    [[ -n "$name" ]] || die "workspace $target is not on screen on any monitor"
  else
    name="$(jq -r --arg n "$target" 'first(.[] | select(.name == $n) | .name) // empty' <<<"$monitors")"
    [[ -n "$name" ]] || die "no monitor $target (have: $(jq -r '[.[].name] | join(" ")' <<<"$monitors"))"
  fi

  if [[ "$name" == WAYLAND-1 ]]; then
    host="$(sed -n 's/^HOST=//p' "$STATE")"
    shown="$(HYPRLAND_INSTANCE_SIGNATURE="$host" hyprctl monitors -j \
      | jq -r --arg w "special:$SCRATCH" '[.[] | select(.specialWorkspace.name == $w)] | length')"
    [[ -n "${HYPR_TESTBED_VISIBLE:-}" || "$shown" == 0 ]] \
      && die "WAYLAND-1 renders only while shown; pick a HEADLESS monitor or start with --headless"
  fi

  [[ -n "$file" ]] || file="$STATE_DIR/screenshot-$name-$(date +%H%M%S).png"
  WAYLAND_DISPLAY="$(sed -n 's/^DISPLAY=//p' "$STATE")" timeout 10 grim -o "$name" "$file" \
    || die "grim failed on $name"
  printf '%s\n' "$file"
}

running() {
  [[ -r "$STATE" ]] || return 1
  local sig; sig="$(sed -n 's/^SIG=//p' "$STATE")"
  [[ -n "$sig" ]] && HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl version >/dev/null 2>&1
}

env_for_eval() {
  running || die "not running"
  printf 'export HYPRLAND_INSTANCE_SIGNATURE=%s\nexport WAYLAND_DISPLAY=%s\nexport CHROMIUM_USER_DATA_DIR=%s\n' \
    "$(sed -n 's/^SIG=//p' "$STATE")" "$(sed -n 's/^DISPLAY=//p' "$STATE")" "$CHROMIUM_DIR"
}

# Killed by the PID recorded at start, checked to still be Hyprland: a pkill pattern
# also matches any shell whose command line happens to mention the config path.
stop() {
  local pid
  [[ -r "$STATE" ]] || { printf 'hypr-testbed: not running\n' >&2; return 0; }

  pid="$(sed -n 's/^PID=//p' "$STATE")"
  if [[ -n "$pid" && "$(ps -o comm= -p "$pid" 2>/dev/null)" == "Hyprland" ]]; then
    kill "$pid" 2>/dev/null
  fi

  rm -f "$STATE"
  printf 'hypr-testbed: stopped\n' >&2
}

case "${1:-}" in
  start)  shift; start "$@" ;;
  env)    env_for_eval ;;
  run)    shift; [[ $# -gt 0 ]] || die "run needs a command"
          running || die "not running"
          env HYPRLAND_INSTANCE_SIGNATURE="$(sed -n 's/^SIG=//p' "$STATE")" \
              WAYLAND_DISPLAY="$(sed -n 's/^DISPLAY=//p' "$STATE")" \
              CHROMIUM_USER_DATA_DIR="$CHROMIUM_DIR" "$@" ;;
  screenshot) shift; screenshot "$@" ;;
  show)   [[ "$(sed -n 's/^HEADLESS=//p' "$STATE" 2>/dev/null)" == 1 ]] \
            && die "started --headless: monitor 1 is disabled, there is nothing to show"
          reveal show ;;
  hide)   reveal hide ;;
  status) if running; then
            sig="$(sed -n 's/^SIG=//p' "$STATE")"
            printf 'running: %s\n' "$sig"
            HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl monitors -j \
              | jq -r '.[] | "  monitor \(.name) \(.width)x\(.height) ws=\(.activeWorkspace.id)"'
            HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl clients -j \
              | jq -r '.[] | "  window  ws=\(.workspace.name) \(.class)"'
          else
            printf 'not running\n'
          fi ;;
  stop)   stop ;;
  *)      sed -n '3,24p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
