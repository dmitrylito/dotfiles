#!/usr/bin/env bash
# secrets-edit — edit the central chezmoi secrets file, then re-render every file built from it.
#
# Usage: secrets-edit
#
# The single source of truth is `.secrets.yaml.age` in the chezmoi source dir: one top-level
# group per rendered env file, rendered by .chezmoitemplates/secrets-env. This script decrypts
# it to tmpfs, opens $EDITOR, validates the YAML, re-encrypts, commits and pushes only that
# file, and applies each target whose template uses secrets-env.
#
# Preconditions: chezmoi's age identity (~/.config/chezmoi/key.txt), git push access to the
# source repo, and a TTY for the editor. Plaintext never leaves $XDG_RUNTIME_DIR (or /tmp).
set -euo pipefail

src="$(chezmoi source-path)"
secrets="$src/.secrets.yaml.age"
work="$(umask 077 && mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/secrets-edit.XXXXXX")"
trap 'rm -rf "$work"' EXIT
plain="$work/secrets.yaml"

chezmoi decrypt "$secrets" > "$plain"
cp "$plain" "$work/before"

while true; do
  "${EDITOR:-vi}" "$plain"
  if chezmoi execute-template "{{ include \"$plain\" | fromYaml | len }}" >/dev/null 2>"$work/err"; then
    break
  fi
  cat "$work/err" >&2
  read -r -p "Invalid YAML. Re-edit? [Y/n] " answer
  [[ $answer == [nN]* ]] && { echo "secrets-edit: nothing saved" >&2; exit 1; }
done

if cmp -s "$plain" "$work/before"; then
  echo "secrets-edit: no changes"
  exit 0
fi

chezmoi encrypt "$plain" > "$work/new.age"
mv "$work/new.age" "$secrets"

git -C "$src" add -- .secrets.yaml.age
git -C "$src" commit -q -m "Update encrypted secrets" -- .secrets.yaml.age
git -C "$src" push -q

# while-read instead of mapfile: macOS ships bash 3.2.
targets=()
while read -r f; do
  targets+=("$(chezmoi target-path "$f")")
done < <(grep -rl --include='*.tmpl' --exclude-dir=.git 'secrets-env' "$src" | grep -v '/\.chezmoitemplates/')
chezmoi apply -- "${targets[@]}"
printf 'secrets-edit: applied %s\n' "${targets[@]}"
