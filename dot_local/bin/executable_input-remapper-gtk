#!/usr/bin/env bash
# Wrapper for /usr/bin/input-remapper-gtk (input-remapper-bin, AUR).
# Usage: input-remapper-gtk [args...] — same as the packaged command.
# Its shebang is `#!/usr/bin/env python3`, which resolves to the mise python3 shim
# (earlier in PATH than /usr/bin). mise's interpreter only has its own site-packages on
# sys.path, so the packaged `inputremapper` module in /usr/lib/python3.14/site-packages
# is invisible and the command dies with ModuleNotFoundError. Pin the system interpreter.
exec /usr/bin/python3 /usr/bin/input-remapper-gtk "$@"
