#!/bin/bash
# moshi-hook-codex-guard — wrapper for the Moshi Codex hooks.
#
# Usage: called from ~/.codex/hooks.json in place of `moshi-hook codex-hook`; the stdin
#        payload is forwarded verbatim and moshi-hook's stdout and exit code are preserved.
#
# The filename MUST contain "moshi-hook": `moshi-hook status` (and the daemon's startup
# check) decides the wiring is intact by looking for that substring in each hook command,
# so a name like moshi-codex-hook is reported as "stale", which tells you to run
# `moshi-hook install --target codex` — the command that overwrites this wrapper.
#
# Why the rebind call: `codex app-server` is one long-lived daemon that spawns every hook,
# so every hook inherits the HERDR_PANE_ID of whichever pane happened to start the daemon.
# moshi-hook trusts that env, so every Codex session in every pane is recorded as living in
# that one pane — normally a pane that is long gone — and the Moshi app answers for a pane
# with the wrong conversation. moshi-pane-rebind --codex-only recovers the real pane by
# matching the session's cwd against the herdr panes that are running Codex, and strips a
# claim it cannot resolve. It only queries Herdr, so it is cheap enough to run per event.

MOSHI_HOOK="${MOSHI_HOOK_BIN:-$HOME/.local/bin/moshi-hook}"
# Hosts without Moshi (the debug profile) still run these hooks: answer empty, never fail.
[ -x "$MOSHI_HOOK" ] || { cat >/dev/null; printf '{}\n'; exit 0; }

payload=$(cat)
output=$(printf '%s' "$payload" | "$MOSHI_HOOK" codex-hook)
exit_code=$?

if [ "$exit_code" -ne 0 ]; then
  printf '%s' "$output"
  exit "$exit_code"
fi

if [ -n "$output" ]; then
  printf '%s\n' "$output"
else
  printf '{}\n'
fi

timeout 5 "$HOME/.local/bin/moshi-pane-rebind" --codex-only >/dev/null 2>&1 || true
