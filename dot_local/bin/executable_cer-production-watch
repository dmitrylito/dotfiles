#!/usr/bin/env bash

set -Eeuo pipefail

readonly REPO=/home/dmitrylito/Projects/cer-backend
readonly BRANCH=production
readonly STATE_DIR=/home/dmitrylito/.local/state/cer-production
readonly DEPLOYED_REVISION_FILE="$STATE_DIR/deployed-revision"

if [[ -x "$REPO/docker/watch-production.sh" ]]; then
  exec "$REPO/docker/watch-production.sh"
fi

mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/deploy.lock"
if ! flock -n 9; then
  echo "Another CER production deployment is already running."
  exit 0
fi

cd "$REPO"

if [[ "$(git branch --show-current)" != "$BRANCH" ]]; then
  echo "Refusing to deploy: $REPO is not on the $BRANCH branch." >&2
  exit 1
fi

if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
  echo "Refusing to deploy: $REPO has local changes or untracked files." >&2
  exit 1
fi

echo "Fetching origin/$BRANCH..."
git fetch --prune origin "$BRANCH"

readonly CURRENT_REVISION="$(git rev-parse HEAD)"
readonly TARGET_REVISION="$(git rev-parse "origin/$BRANCH")"

if ! git merge-base --is-ancestor "$CURRENT_REVISION" "$TARGET_REVISION"; then
  echo "Refusing to deploy: origin/$BRANCH is not a fast-forward of the local checkout." >&2
  exit 1
fi

if [[ "$CURRENT_REVISION" != "$TARGET_REVISION" ]]; then
  git merge --ff-only "$TARGET_REVISION"
fi

deployed_revision=""
if [[ -f "$DEPLOYED_REVISION_FILE" ]]; then
  deployed_revision="$(<"$DEPLOYED_REVISION_FILE")"
fi

if [[ "$deployed_revision" == "$TARGET_REVISION" ]]; then
  echo "CER production is already deployed at $TARGET_REVISION."
  exit 0
fi

if [[ -f "$REPO/docker/compose.yaml" ]]; then
  readonly -a COMPOSE=(
    docker compose
    --project-directory "$REPO/docker"
    -p prod
    -f "$REPO/docker/compose.yaml"
  )
else
  # Transitional support until compose.yaml reaches the production branch.
  readonly -a COMPOSE=(
    docker compose
    --project-directory "$REPO/docker"
    -p prod
    -f "$REPO/docker/docker-compose.yml"
    -f "$REPO/docker/docker-compose.prod.yml"
  )
  export CER_PRODUCTION_CHECKOUT="$REPO"
fi

echo "Deploying CER production revision $TARGET_REVISION..."
"${COMPOSE[@]}" config --quiet
"${COMPOSE[@]}" build backend migrate worker
"${COMPOSE[@]}" up -d db
"${COMPOSE[@]}" run --rm migrate
"${COMPOSE[@]}" up -d --no-build backend worker

healthy=false
for _ in {1..30}; do
  if curl --fail --silent --show-error --output /dev/null \
    http://127.0.0.1:18000/admin/login/; then
    healthy=true
    break
  fi
  sleep 2
done

if [[ "$healthy" != true ]]; then
  echo "Deployment did not pass the local HTTP health check." >&2
  exit 1
fi

if [[ "$(docker inspect --format '{{.State.Running}}' cer-prod-worker)" != true ]]; then
  echo "Deployment failed: cer-prod-worker is not running." >&2
  exit 1
fi

revision_tmp="$DEPLOYED_REVISION_FILE.tmp"
printf '%s\n' "$TARGET_REVISION" >"$revision_tmp"
mv "$revision_tmp" "$DEPLOYED_REVISION_FILE"
echo "CER production deployed successfully at $TARGET_REVISION."
