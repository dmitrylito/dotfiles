{
  "manifest_version": 3,
  "name": "window-time",
  "version": "1.1",
  "description": "Reports the active tab's URL and title, and the FC console customer, to the local window-time tracker (dotfiles: dot_local/bin/executable_window-time). Nothing leaves this machine.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background-2.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.fleetchaser.com/*"
      ],
      "js": [
        "fc-console-1.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
