#!/bin/sh
# lid-guard: when the MacBook lid closes with no external display connected, mute audio
# output and sleep the display (which locks the screen, since the lock delay is "immediate").
# When the lid opens again, unmute only if lid-guard did the muting.
#
# Usage: run by the LaunchAgent com.dmitrylito.lid-guard; not run by hand.
#        LID_GUARD_INTERVAL sets the lid poll interval in seconds (default 2).
# Precondition: staying awake with the lid closed needs `sudo pmset -a disablesleep 1`,
#        a one-time system setting this script does not change.
set -u

interval="${LID_GUARD_INTERVAL:-2}"

lid_closed() {
	ioreg -r -k AppleClamshellState -d 4 | grep -q '"AppleClamshellState" = Yes'
}

external_displays() {
	system_profiler SPDisplaysDataType | awk '
		/^        [^ ].*:$/ { n++ }
		/Connection Type: Internal|Display Type: Built-in/ { internal[n] = 1 }
		END { e = 0; for (i = 1; i <= n; i++) if (!internal[i]) e++; print e }'
}

was_closed=0
we_muted=0
lid_closed && was_closed=1
while :; do
	if lid_closed; then
		if [ "$was_closed" = 0 ]; then
			was_closed=1
			if [ "$(external_displays)" = 0 ]; then
				if [ "$(osascript -e 'output muted of (get volume settings)')" = false ]; then
					osascript -e 'set volume output muted true'
					we_muted=1
				fi
				pmset displaysleepnow
				echo "$(date '+%F %T') lid closed, no external display: muted=$we_muted, locked"
			fi
		fi
	elif [ "$was_closed" = 1 ]; then
		was_closed=0
		if [ "$we_muted" = 1 ]; then
			osascript -e 'set volume output muted false'
			we_muted=0
			echo "$(date '+%F %T') lid opened: unmuted"
		fi
	fi
	sleep "$interval"
done
