#!/bin/sh
# moshi-hook-claude-guard — guard wrapper for the Moshi Claude Code hooks.
#
# Usage: called from ~/.claude/settings.json in place of `moshi-hook claude-hook`;
#        every argument and the stdin payload are forwarded verbatim, and moshi-hook's
#        stdout/stderr and exit code are preserved.
#
# Why this exists: a tty-less Claude session (background job or scheduled agent) can
# inherit HERDR_PANE_ID even though it does not occupy that pane. moshi-hook trusts the
# inherited value, so the background session can steal the visible pane's conversation.
#
# Such sessions must still REGISTER: the Moshi app needs the record to show the chat and
# its history, and moshi-hook refreshes transcriptPath on every event, which is what
# repairs history after Claude Code relocates a transcript on a cwd change (entering a
# worktree). This wrapper forwards the event, then removes an inherited Herdr binding. A
# binding established by moshi-pane-rebind is preserved across later hook events.
#
# Verified 2026-07-27 against moshi-hook 0.2.61.

MOSHI_HOOK="${MOSHI_HOOK_BIN:-$HOME/.local/bin/moshi-hook}"
[ -x "$MOSHI_HOOK" ] || exit 0

# /proc/self/stat field 7 is tty_nr, and 0 means no controlling terminal. Fields are
# counted after the last ')' because comm can itself contain spaces and parentheses.
tty_nr=$(sed 's/.*) //' /proc/self/stat 2>/dev/null | cut -d' ' -f5)
[ -n "$tty_nr" ] && [ "$tty_nr" -ne 0 ] 2>/dev/null && exec "$MOSHI_HOOK" "$@"

payload=$(mktemp) || exec "$MOSHI_HOOK" "$@"
cat >"$payload"
sid=$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$payload" | head -1)
record="${MOSHI_STATE_DIR:-$HOME/.local/state/moshi}/claude-sessions/$sid.json"

# Remember a binding previously established by moshi-pane-rebind. The vendor hook can
# overwrite it with the app-server's inherited HERDR_PANE_ID on every event.
keep=""
if [ -n "$sid" ] && grep -q '"herdrPane"' "$record" 2>/dev/null; then
    keep=$(mktemp) && cp "$record" "$keep"
fi

"$MOSHI_HOOK" "$@" <"$payload"
rc=$?
rm -f "$payload"

if [ -n "$sid" ] && { [ -n "$keep" ] || grep -q '"herdrPane"' "$record" 2>/dev/null; }; then
    python3 - "$record" "$keep" <<'PY'
import json, os, sys
path = sys.argv[1]
prior = sys.argv[2] if len(sys.argv) > 2 else ''
try:
    with open(path) as fh:
        record = json.load(fh)
except Exception:
    sys.exit(0)
binding = {}
if prior:
    try:
        with open(prior) as fh:
            old = json.load(fh)
        binding = {k: old[k] for k in
                   ('herdrPane', 'herdrWorkspaceId', 'herdrTabId', 'terminalKind')
                   if k in old}
    except Exception:
        binding = {}
before = {k: record.get(k) for k in
          ('herdrPane', 'herdrWorkspaceId', 'herdrTabId', 'terminalKind')}
for key in before:
    record.pop(key, None)
record.update(binding)          # empty for a cwd guess, so the guess is simply dropped
if {k: record.get(k) for k in before} == before:
    sys.exit(0)
tmp = path + '.guard.tmp'
try:
    with open(tmp, 'w') as fh:
        json.dump(record, fh, indent=2)
    os.replace(tmp, path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
PY
fi
[ -n "$keep" ] && rm -f "$keep"

exit $rc
