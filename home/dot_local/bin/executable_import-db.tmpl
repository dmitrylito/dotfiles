#!/bin/bash
#
# import-db — refresh the local FleetChaser database from the latest prod export.
#
# The restore itself is backend's own scripts/dev/load-local-db.sh, run with its defaults (the
# parallel Cloud SQL export, pg_restore -j) from the checkout whose docker/ is the live stack.
# This wrapper adds what a nightly job needs around it: the cron trigger, a lock, logs, the
# db-importer service-account key, a volume snapshot after a good load, and recovery from that
# snapshot when a load fails after it dropped the database. Then, when ops-center's
# PLATFORM_DB_REFRESH script exists on this host, it loads the snapshot into the
# ops-platform-db copy (ops-center docs/platform-db.md); its failure is logged and does not
# fail the import.
#
# Detaches immediately, so it is safe from cron or by hand. Logs to
# ~/Logs/import_db.log; previous runs rotate to .1 … .N (IMPORT_DB_LOG_KEEP, default 7).
#
# Usage:
#   import-db          # background, prints PID + log path
#   import-db --fg     # foreground, still logs to file
#   import-db --if-new # cron checker: starts a run only when the export pointer names a
#                      # different export than the last run loaded; silent otherwise
#
# Each export is attempted once: a run records it before restoring, so a failed run is not
# retried by --if-new (rerun plain import-db). A flock on ~/.local/state/import-db/lock keeps
# two runs from overlapping.
#
# Needs: docker compose, docker-volume-snapshot, gcloud, flock, ~/gcs-key.json (db-importer,
# with read access to gs://fleetchaser-prod-db-exports), and load-local-db.sh in the checkout.
#
# Chezmoi-managed (dot_local/bin/executable_import-db.tmpl); only COMPOSE_DIR differs per host.

LOG_DIR="$HOME/Logs"
LOG_FILE="$LOG_DIR/import_db.log"
LOG_KEEP="${IMPORT_DB_LOG_KEEP:-7}"
{{- if eq .chezmoi.hostname "fcoffice" }}

COMPOSE_DIR="$HOME/Projects/fleetchaser/backend/docker"
{{- else }}

COMPOSE_DIR="$HOME/Projects/backend/docker"
{{- end }}
LOAD_SCRIPT="$COMPOSE_DIR/../scripts/dev/load-local-db.sh"
EXPORT_POINTER="gs://fleetchaser-prod-db-exports/backend/latest-parallel-root.uri"
GCS_KEY_PATH="$HOME/gcs-key.json"
# Outside the repo: the script's default (<repo>/dumps) is not git-ignored.
DUMP_DIR="$HOME/fleetchaser-db"
SNAPSHOT_FILE="$HOME/Projects/tmp/docker/fleetchaser_db_volume"
VOLUME_NAME="fleetchaser_db_volume"
PLATFORM_DB_REFRESH="${PLATFORM_DB_REFRESH:-$HOME/Projects/ops-center/docker/platform-db/refresh.sh}"
STATE_DIR="$HOME/.local/state/import-db"
LAST_EXPORT_FILE="$STATE_DIR/last-export"
LOCK_FILE="$STATE_DIR/lock"
export PATH="$HOME/google-cloud-sdk/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
# gsutil ignores this and demands interactive reauth; gcloud storage (which the script uses)
# honours it.
export CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE="$GCS_KEY_PATH"
# A shell that inherited another project's compose settings would point every compose call
# below, and the script's, at that project.
unset COMPOSE_PROJECT_NAME COMPOSE_FILE COMPOSE_PROFILES

#######################################
# Detach
#######################################
mkdir -p "$LOG_DIR" "$STATE_DIR"

# Must run in the parent, before the detached child opens the log for append.
rotate_logs() {
  [ -s "$LOG_FILE" ] || return 0
  rm -f "$LOG_FILE.$LOG_KEEP"
  local i
  for ((i = LOG_KEEP - 1; i >= 1; i--)); do
    [ -f "$LOG_FILE.$i" ] && mv "$LOG_FILE.$i" "$LOG_FILE.$((i + 1))"
  done
  mv "$LOG_FILE" "$LOG_FILE.1"
}

latest_export() { gcloud storage cat "$EXPORT_POINTER" | tr -d '[:space:]'; }

if [ "${1:-}" = "--if-new" ]; then
  shift
  flock -n "$LOCK_FILE" true || exit 0
  export_uri="$(latest_export)" || { echo "import-db --if-new: could not read $EXPORT_POINTER." >&2; exit 1; }
  [ "$export_uri" = "$(cat "$LAST_EXPORT_FILE" 2>/dev/null)" ] && exit 0
  echo "$(date '+%Y-%m-%d %H:%M:%S') new export $export_uri."
fi

if [ "${1:-}" = "--fg" ]; then
  shift
elif [ -z "${IMPORT_DB_DETACHED:-}" ]; then
  # Checked before rotating, which would otherwise move the running import's log away.
  if ! flock -n "$LOCK_FILE" true; then
    echo "import-db is already running; not starting another." >&2
    exit 1
  fi
  export IMPORT_DB_DETACHED=1
  rotate_logs
  setsid "$0" "$@" >>"$LOG_FILE" 2>&1 </dev/null &
  echo "import-db started in the background (PID $!)."
  echo "Follow:    tail -f $LOG_FILE"
  exit 0
fi

#######################################
# Logging
#######################################
set -Eeuo pipefail

log() {
  local tag="$1"; shift
  printf '%s [%-8s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$tag" "$*" >&2
}

fmt_duration() {
  local s=$1
  if ((s >= 3600)); then printf '%dh%02dm%02ds' $((s / 3600)) $((s % 3600 / 60)) $((s % 60))
  elif ((s >= 60)); then printf '%dm%02ds' $((s / 60)) $((s % 60))
  else printf '%ds' "$s"; fi
}

STEP_START=0
step_begin() { STEP_START=$SECONDS; log "$@"; }
step_done() {
  local tag="$1"; shift
  log "$tag" "Done in $(fmt_duration $((SECONDS - STEP_START)))${*:+ ($*)}."
}

RUN_START=$SECONDS
trap 'log Error "Line $LINENO failed (exit $?): $BASH_COMMAND"; log Error "Aborted after $(fmt_duration $((SECONDS - RUN_START)))."' ERR

#######################################
# Steps
#######################################
require_tools() {
  local missing=()
  for t in docker docker-volume-snapshot gcloud flock; do
    command -v "$t" >/dev/null 2>&1 || missing+=("$t")
  done
  [ -f "$GCS_KEY_PATH" ] || missing+=("$GCS_KEY_PATH")
  [ -x "$LOAD_SCRIPT" ] || missing+=("$LOAD_SCRIPT (not on the checked-out branch?)")
  if ((${#missing[@]})); then
    log Error "Missing: ${missing[*]}. Nothing was changed."
    exit 1
  fi
}

record_export() {
  local export_uri
  export_uri="$(latest_export)"
  printf '%s\n' "$export_uri" >"$LAST_EXPORT_FILE.tmp" && mv "$LAST_EXPORT_FILE.tmp" "$LAST_EXPORT_FILE"
  log Start "Export $export_uri."
}

# load-local-db.sh checks the download and that pg_restore can run before it drops anything,
# and checks the result after. Its output goes to this log.
LOAD_LOG=""
load_database() {
  step_begin Load "Running $LOAD_SCRIPT --yes (DUMP_DIR=$DUMP_DIR)."
  LOAD_LOG="$(mktemp)"
  local rc=0
  DUMP_DIR="$DUMP_DIR" "$LOAD_SCRIPT" --yes 2>&1 | tee "$LOAD_LOG" >&2 || rc=$?
  if ((rc == 0)); then
    step_done Load
    rm -f "$LOAD_LOG"
  fi
  return "$rc"
}

# The step header is printed just before dropdb, so its presence means the old database is gone.
dropped_database() { grep -q '^==> Recreating the ' "$LOAD_LOG"; }

recover_from_snapshot() {
  cd "$COMPOSE_DIR"
  if [ ! -f "$SNAPSHOT_FILE" ]; then
    log Error "No snapshot at $SNAPSHOT_FILE to recover from; starting the stack on the partial database."
    docker compose --progress quiet up -d
    return 1
  fi
  step_begin Recover "Load failed after the drop: restoring $VOLUME_NAME from $SNAPSHOT_FILE (last good run)."
  docker compose --progress quiet stop
  docker compose --progress quiet rm -f db
  # Required: the snapshot restore is a bare tar extract with no wipe, so extracting over a
  # half-written PGDATA leaves a corrupt cluster.
  docker volume rm "$VOLUME_NAME" >/dev/null
  docker-volume-snapshot restore "$SNAPSHOT_FILE" "$VOLUME_NAME" >/dev/null
  docker compose --progress quiet up -d
  step_done Recover "the previous good copy is back; run 'just migrate' if your branch needs it"
}

handle_load_failure() {
  trap - ERR
  if dropped_database; then
    recover_from_snapshot || true
  else
    log Error "Load failed before the drop; the database is unchanged. Starting anything it stopped."
    cd "$COMPOSE_DIR" && docker compose --progress quiet up -d
  fi
  rm -f "$LOAD_LOG"
  log Error "Failed after $(fmt_duration $((SECONDS - RUN_START)))."
  exit 1
}

snapshot_and_restart() {
  step_begin Stack "Stopping the stack and snapshotting $VOLUME_NAME to $SNAPSHOT_FILE."
  cd "$COMPOSE_DIR"
  # stop, not down: backend's redis has no named volume, so every down/up left its
  # old anonymous /data volume behind (one orphan per night).
  docker compose --progress quiet stop
  mkdir -p "$(dirname "$SNAPSHOT_FILE")"
  # stdout is a per-file tar listing (~330k lines); stderr still surfaces failures.
  if docker-volume-snapshot create "$VOLUME_NAME" "$SNAPSHOT_FILE" >/dev/null; then
    log Stack "Snapshot is $(du -h "$SNAPSHOT_FILE" | cut -f1). Starting the full stack."
  else
    log Error "Snapshot failed, so the next failed load has nothing to recover from. Starting the full stack."
  fi
  docker compose --progress quiet up -d
  step_done Stack
}

refresh_platform_copy() {
  [[ -x "$PLATFORM_DB_REFRESH" ]] || return 0
  step_begin Platform "Loading the snapshot into ops-platform-db ($PLATFORM_DB_REFRESH)."
  if "$PLATFORM_DB_REFRESH"; then
    step_done Platform
  else
    log Error "Platform DB copy refresh failed; ops-platform-db keeps its previous copy (~/.local/state/ops-center/platform-db/last-refresh.json)."
  fi
}

#######################################
# Main
#######################################
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log Error "Another import-db run holds $LOCK_FILE."
  exit 1
fi
log Start "Refreshing via load-local-db.sh (compose=$COMPOSE_DIR)."
require_tools
record_export
load_database || handle_load_failure
snapshot_and_restart
refresh_platform_copy
log Finish "Finished. Total $(fmt_duration $((SECONDS - RUN_START)))."
