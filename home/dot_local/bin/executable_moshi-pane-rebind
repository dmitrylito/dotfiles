#!/usr/bin/env python3
# moshi-pane-rebind — keep Moshi's pane->conversation bindings pointing at the job each
# Herdr pane is actually displaying.
#
# Usage: moshi-pane-rebind [--dry-run] [--verbose] [--codex-only]
#        Run periodically (moshi-pane-rebind.timer); --codex-only is the per-event fast path
#        called from moshi-hook-codex-guard. Safe to run any time; it only edits Herdr
#        and transcriptPath fields of records under ~/.local/state/moshi/claude-sessions/
#        and ~/.local/state/moshi/codex-sessions/, and never deletes a record.
#
# Why: Moshi assumes one pane == one agent session. Viewing a background job in a
# pane breaks that — the job owns the conversation but is tty-less, while the terminal
# that displays it registers its own Claude session that is never prompted and so never
# gets a transcript. Moshi binds the pane to that empty session, the gateway answers 404,
# and the app spins on "connecting" with a blank chat.
#
# Claude Code renders the job's name in the pane, and ~/.claude/jobs/*/state.json holds
# that same name plus the authoritative sessionId and current transcript path
# (linkScanPath, which follows the transcript when a cwd change relocates it). Matching
# the two gives an exact pane -> conversation mapping.
#
# Panes whose bound session has no transcript, and which match no job, have the stale
# claim removed so they stop hijacking the pane.
#
# Codex has the same symptom from a different cause: `codex app-server` is one long-lived
# daemon that spawns every hook, so all hooks inherit the HERDR_PANE_ID of whichever pane
# happened to launch it. moshi-hook trusts that env, so every Codex session in every pane is
# recorded in that one pane — usually a pane that no longer exists — and the app shows the
# wrong conversation. The Codex hook payload carries `cwd`, and herdr reports which panes are
# running Codex and their cwd, so the pane is recovered by matching the two; an ambiguous or
# unmatched claim is stripped rather than guessed. Session cwd comes from the rollout file
# under ~/.codex/sessions, whose name embeds the session id.
#
# Records whose transcriptPath no longer exists are repointed at ~/.claude/projects/*/<id>.jsonl.
# Claude Code files a transcript under a directory derived from the session's cwd, so entering
# a worktree moves it and removing that worktree moves it back; only job-matched panes get an
# authoritative path (linkScanPath), so an interactive session that relocated otherwise keeps a
# dead path and the app serves an empty chat.

import argparse
import glob
import json
import os
import re
import socket
import subprocess
import sys
import time

STATE = os.path.expanduser(os.environ.get("MOSHI_STATE_DIR", "~/.local/state/moshi"))
RECORDS = os.path.join(STATE, "claude-sessions")
CODEX_RECORDS = os.path.join(STATE, "codex-sessions")
CODEX_SESSIONS = os.path.expanduser("~/.codex/sessions")
JOBS = os.path.expanduser("~/.claude/jobs")
PROJECTS = os.path.expanduser("~/.claude/projects")
# The self-updating copy first: a herdr client only talks to a server of the same protocol,
# and a distro package can sit a revision ahead of the server that is actually running.
HERDR = next((p for p in (os.environ.get("MOSHI_HERDR_PATH", ""),
                          os.path.expanduser("~/.local/bin/herdr"),
                          "/usr/local/bin/herdr", "/usr/bin/herdr")
              if p and os.path.exists(p)), "herdr")
HERDR_FIELDS = ("herdrPane", "herdrWorkspaceId", "herdrTabId", "terminalKind")
CODEX_FIELDS = ("herdrPane", "herdrWorkspaceId", "herdrTabId", "herdrWorkspace", "herdrTab",
                "terminalKind")
HERDR_SOCKET = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser(
    "~/.config/herdr/herdr.sock")
# herdr reports the pane title with Claude Code's status glyph still on it: "◑ my job"
GLYPH = re.compile(r"^[^\w(\[]+")

args = argparse.ArgumentParser()
args.add_argument("--dry-run", action="store_true")
args.add_argument("--verbose", action="store_true")
args.add_argument("--codex-only", action="store_true",
                  help="run only the Codex pass; safe to call from a hook")
opts = args.parse_args()
changes = []


def log(msg):
    if opts.verbose:
        print(msg)


def herdr_pane_rows():
    try:
        listed = subprocess.run([HERDR, "pane", "list"],
                                capture_output=True, text=True, timeout=10)
        rows = json.loads(listed.stdout)["result"]["panes"]
    except Exception:
        return []
    return [row for row in rows if row.get("pane_id")]


def herdr_panes():
    """[(pane_id, workspace_id, tab_id, title)]"""
    return [(row.get("pane_id"), row.get("workspace_id"), row.get("tab_id"),
             (row.get("terminal_title_stripped") or "").strip())
            for row in herdr_pane_rows()]


def jobs_by_name():
    by_name = {}
    for path in glob.glob(os.path.join(JOBS, "*", "state.json")):
        try:
            with open(path) as fh:
                job = json.load(fh)
        except Exception:
            continue
        name, sid = job.get("name"), job.get("sessionId")
        if not name or not sid:
            continue
        # Most recently updated wins when two jobs share a name.
        if name not in by_name or job.get("updatedAt", "") > by_name[name].get("updatedAt", ""):
            by_name[name] = job
    return by_name


def load(sid):
    path = os.path.join(RECORDS, sid + ".json")
    try:
        with open(path) as fh:
            return path, json.load(fh)
    except Exception:
        return path, None


def save(path, record):
    if opts.dry_run:
        return
    tmp = path + ".rebind.tmp"
    with open(tmp, "w") as fh:
        json.dump(record, fh, indent=2)
    os.replace(tmp, path)


def has_transcript(record):
    p = record.get("transcriptPath") or ""
    return bool(p) and os.path.exists(p)


def find_transcript(sid):
    hits = glob.glob(os.path.join(PROJECTS, "*", sid + ".jsonl"))
    # A session that moved twice leaves a stub behind in the directory it came from.
    return max(hits, key=os.path.getmtime) if hits else None


def codex_session_cwd(sid):
    # The rollout file name embeds the session id, and its first line is the session_meta
    # record carrying the cwd the session was started in.
    hits = glob.glob(os.path.join(CODEX_SESSIONS, "**", "rollout-*" + sid + ".jsonl"),
                     recursive=True)
    for path in sorted(hits, key=os.path.getmtime, reverse=True):
        try:
            with open(path) as fh:
                meta = json.loads(fh.readline())
        except Exception:
            continue
        cwd = (meta.get("payload") or {}).get("cwd")
        if cwd:
            return cwd
    return None


def report_agent_session(pane, sid):
    """Tell herdr which Codex conversation a pane holds.

    The Moshi gateway reads a pane's session identity from herdr's agent_session, not from
    its own records, so a Codex pane without one is served with no sessionId and the app
    falls back to the wrong conversation. herdr's own Codex integration cannot fill this in:
    it reads HERDR_PANE_ID, which every Codex hook inherits from the app-server daemon.
    """
    if opts.dry_run:
        return True
    request = {
        "id": f"moshi-pane-rebind:{time.time_ns()}",
        "method": "pane.report_agent_session",
        "params": {"pane_id": pane, "source": "herdr:codex", "agent": "codex",
                   "seq": time.time_ns(), "agent_session_id": sid},
    }
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(0.5)
        client.connect(HERDR_SOCKET)
        client.sendall((json.dumps(request) + "\n").encode())
        try:
            client.recv(4096)
        except Exception:
            pass
        client.close()
    except Exception:
        return False
    return True


def codex_activity(record):
    # File mtime is useless here: this script rewrites records, so it must rank them by the
    # session timestamps moshi-hook wrote instead.
    stamps = [record.get(k) for k in
              ("lastStopTime", "firstPromptPushedAt", "sessionStartTime")]
    return max((v for v in stamps if isinstance(v, (int, float))), default=0)


def codex_records():
    out = []
    for path in glob.glob(os.path.join(CODEX_RECORDS, "*.json")):
        try:
            with open(path) as fh:
                record = json.load(fh)
        except Exception:
            continue
        out.append((path, record))
    # Live sessions first, then most recently active.
    out.sort(key=lambda pr: (not pr[1].get("sessionEndedAt"), codex_activity(pr[1])),
             reverse=True)
    return out


def codex_pass():
    if not os.path.isdir(CODEX_RECORDS):
        return
    panes = [row for row in herdr_pane_rows() if row.get("agent") == "codex"]
    records = codex_records()
    live = {row["pane_id"] for row in panes}
    owner = {}

    if panes:
        cwds = {}
        for path, record in records:
            sid = os.path.basename(path)[:-5]
            cwds[sid] = codex_session_cwd(sid)
        for row in sorted(panes, key=lambda r: r["pane_id"]):
            pane_cwds = {row.get("cwd"), row.get("foreground_cwd")} - {None}
            # Newest first, and a session the daemon has not ended beats one it has.
            ranked = [(path, record) for path, record in records
                      if cwds.get(os.path.basename(path)[:-5]) in pane_cwds]
            pick = next((pr for pr in ranked
                         if os.path.basename(pr[0])[:-5] not in owner.values()), None)
            if not pick:
                continue
            path, record = pick
            sid = os.path.basename(path)[:-5]
            owner[row["pane_id"]] = sid
            desired = dict(terminalKind="herdr", herdrPane=row["pane_id"],
                           herdrWorkspaceId=row.get("workspace_id"),
                           herdrTabId=row.get("tab_id"))
            if {k: record.get(k) for k in desired} != desired:
                for key in CODEX_FIELDS:
                    record.pop(key, None)
                record.update(desired)
                save(path, record)
                changes.append(f"bound codex {row['pane_id']} -> {sid[:8]}")
            known = (row.get("agent_session") or {}).get("value")
            if known != sid and report_agent_session(row["pane_id"], sid):
                changes.append(f"reported codex session {sid[:8]} for {row['pane_id']}")

    # A claim on a pane that is not a live Codex pane, or on one another session owns, is
    # the inherited app-server env talking. Drop it rather than let it answer for the pane.
    for path, record in records:
        sid = os.path.basename(path)[:-5]
        pane = record.get("herdrPane")
        if pane and not (pane in live and owner.get(pane) == sid):
            for key in CODEX_FIELDS:
                record.pop(key, None)
            save(path, record)
            changes.append(f"cleared codex claim on {pane} by {sid[:8]}")


def emit():
    for line in changes:
        log(line)
    if opts.dry_run and changes:
        print("\n".join(changes))


codex_pass()
if opts.codex_only:
    emit()
    sys.exit(0)

if not os.path.isdir(RECORDS):
    sys.exit(0)

by_name = jobs_by_name()
bound = {}

def bind(pane, title, desired, fields):
    job = by_name.get(title) or by_name.get(GLYPH.sub("", title).strip()) if title else None
    if not job:
        return
    sid = job["sessionId"]
    path, record = load(sid)
    if record is None:
        return
    transcript = job.get("linkScanPath") or record.get("transcriptPath")
    current = {k: record.get(k) for k in fields}
    if current != desired or (transcript and record.get("transcriptPath") != transcript
                              and os.path.exists(transcript)):
        record.update(desired)
        if transcript and os.path.exists(transcript):
            record["transcriptPath"] = transcript
        save(path, record)
        changes.append(f"bound {pane} -> {sid[:8]} ({title})")
    bound[pane] = sid


for pane, workspace, tab, title in herdr_panes():
    bind(pane, title, dict(terminalKind="herdr", herdrPane=pane,
                           herdrWorkspaceId=workspace, herdrTabId=tab), HERDR_FIELDS)

for path in glob.glob(os.path.join(RECORDS, "*.json")):
    try:
        with open(path) as fh:
            record = json.load(fh)
    except Exception:
        continue
    if has_transcript(record):
        continue
    sid = os.path.basename(path)[:-5]
    found = find_transcript(sid)
    if not found:
        continue
    record["transcriptPath"] = found
    save(path, record)
    changes.append(f"repaired transcript for {sid[:8]} -> "
                   f"{os.path.basename(os.path.dirname(found))}")

# Resolve panes with more than one claimant: whichever the gateway picks, the losers make
# it answer 404. A pane matched to a job has an exact answer; otherwise prefer a claimant
# that can actually serve a transcript, falling back to the newest.
#
# Never strip the sole claimant of an unmatched pane just because it has no transcript —
# that is what a foreground Claude looks like before its first prompt, and moshi-hook only
# sets the pane at SessionStart, so clearing it would never be undone.
for pane_key, fields in (("herdrPane", HERDR_FIELDS),):
    claimants = {}
    for path in glob.glob(os.path.join(RECORDS, "*.json")):
        try:
            with open(path) as fh:
                record = json.load(fh)
        except Exception:
            continue
        pane = record.get(pane_key)
        if pane:
            claimants.setdefault(pane, []).append((path, record))

    for pane, holders in claimants.items():
        if pane in bound:
            keeper = bound[pane]
        elif len(holders) == 1:
            continue
        else:
            ranked = sorted(holders,
                            key=lambda h: (has_transcript(h[1]), os.path.getmtime(h[0])),
                            reverse=True)
            keeper = os.path.basename(ranked[0][0])[:-5]
        for path, record in holders:
            sid = os.path.basename(path)[:-5]
            if sid == keeper:
                continue
            for key in fields:
                record.pop(key, None)
            save(path, record)
            changes.append(f"cleared competing claim on {pane} by {sid[:8]}")

emit()
