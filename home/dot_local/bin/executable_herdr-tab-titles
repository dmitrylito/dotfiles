#!/usr/bin/env python3
# Name Herdr app tabs after the Claude Code session running in them: the terminal title
# Claude sets (its session name or topic), minus the leading status glyph.
#
# Usage:
#   herdr-tab-titles          reconcile forever (herdr-tab-titles.service runs this)
#   herdr-tab-titles --once   one pass, then exit
#
# Env:
#   HERDR_TAB_TITLES_INTERVAL  seconds between passes (default: 2)
#
# Only tabs nobody named (their name is their position, "1", "2", ...) or that this
# script named are touched, so a name given with tab.rename (F2 / Alt+R) sticks. Clear
# it (rename to "") to hand the tab back. Remote machines' tabs are included.
# Needs a running herdr-app window; passes fail quietly until one is up.
import json
import os
import re
import subprocess
import sys
import time

INTERVAL = float(os.environ.get("HERDR_TAB_TITLES_INTERVAL", "2"))
STATE = os.path.expanduser("~/.local/state/herdr-tab-titles.json")
GLYPH = re.compile(r"^[^\w]+", re.UNICODE)
GENERIC = {"", "claude", "claude code"}


def run_json(*args):
    out = subprocess.run(args, capture_output=True, text=True, timeout=15)
    if out.returncode:
        raise RuntimeError(f"{' '.join(args)}: {(out.stderr or out.stdout).strip()}")
    return json.loads(out.stdout)


def load_state():
    try:
        with open(STATE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, indent=1, sort_keys=True)
    os.replace(tmp, STATE)


def session_title(address):
    title = run_json("hc", "get", "--json", address).get("title") or ""
    title = GLYPH.sub("", title).strip()
    return None if title.lower() in GENERIC else title


def reconcile(state):
    seen = {}
    for space in run_json("herdr-app", "ls")["spaces"]:
        for tab in space["tabs"]:
            claude = next((t["terminal"] for t in tab["terminals"] if t.get("app") == "claude-code"), None)
            if not claude:
                continue
            ours = state.get(tab["id"])
            if not (tab["name"].isdigit() or tab["name"] == ours):
                continue
            seen[tab["id"]] = ours
            try:
                title = session_title(claude)
            except (RuntimeError, ValueError, subprocess.TimeoutExpired) as exc:
                print(f"{claude}: {exc}", flush=True)
                continue
            if title and title != tab["name"]:
                run_json("herdr-app", "do", "tab.rename", "--id", tab["id"], "--name", title)
                seen[tab["id"]] = title
                print(f"{tab['id']}: {title}", flush=True)
    return {k: v for k, v in seen.items() if v}


def main():
    once = sys.argv[1:] == ["--once"]
    if sys.argv[1:] and not once:
        sys.exit("usage: herdr-tab-titles [--once]")
    state = load_state()
    while True:
        try:
            new = reconcile(state)
            if new != state:
                state = new
                save_state(state)
        except Exception as exc:  # noqa: BLE001 — herdr-app down or restarting must not kill the loop
            print(f"pass failed: {exc}", flush=True)
        if once:
            return
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
