name: caddy

services:
  caddy:
    build: .
    image: local/caddy-cloudflare:2.11.7
    restart: unless-stopped
    env_file: {{ joinPath .chezmoi.homeDir ".config/secrets/caddy.env" }}
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config

  # Owns the 192.168.0.3 VIP. Host networking and NET_ADMIN let it add the address to the
  # host's LAN interface; firewalld must accept VRRP (IP protocol 112) between the nodes.
  keepalived:
    build: ./keepalived
    image: local/keepalived:alpine3.24
    restart: unless-stopped
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_BROADCAST
      - NET_RAW
    volumes:
      - ./keepalived/keepalived.conf:/etc/keepalived/keepalived.conf:ro
    depends_on:
      - caddy

  # Every node runs a replica of the same tunnel; Cloudflare keeps serving while any one is up.
  # TUNNEL_TOKEN comes from the caddy secrets group. Ingress rules live in Cloudflare, not here.
  cloudflared:
    image: cloudflare/cloudflared:2026.11.0
    restart: unless-stopped
    command: tunnel --no-autoupdate run
    env_file: {{ joinPath .chezmoi.homeDir ".config/secrets/caddy.env" }}
    depends_on:
      - caddy

volumes:
  caddy_data:
  caddy_config:
