{{- if eq (.profile | lower) "omarchy" -}}
# For hosts that getty-autologin on tty1 instead of SDDM (fcoffice uses SDDM): starts
# the uwsm-managed Hyprland session.
if [[ -z $WAYLAND_DISPLAY && $XDG_VTNR -eq 1 ]] && uwsm check may-start -q; then
  exec uwsm start -e -D Hyprland hyprland.desktop
fi
{{- end }}
