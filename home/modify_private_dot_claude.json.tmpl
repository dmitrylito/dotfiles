#!/usr/bin/env python3
# modify_.claude.json — forces a few Claude Code UI preferences and home-folder trust on
# every machine.
#
# Usage: not run by hand. chezmoi executes this on every `apply` with the CURRENT target on
#        stdin; stdout becomes the new file.
#
# Why a modify_ script rather than a tracked file: ~/.claude.json is ~90KB of per-machine
# runtime state — machineID, userID, numStartups, feature caches and the whole per-project
# history. Tracking it would sync one box's identity and history onto the others and drift
# on every launch. Here the live file is the INPUT, so only ENFORCED keys are touched and
# everything else passes through untouched.
#
# These keys live here and NOT in settings.json: /config writes them to ~/.claude.json.
# A live file that will not parse is passed through unchanged rather than replaced — it
# holds state this script cannot reconstruct.

import json
import sys

ENFORCED = {
    "defaultToAgentsView": True,
}
HOME = {{ .chezmoi.homeDir | quote }}
# Defaults Claude Code gives a new project entry; a bare {} entry lacks keys it reads.
PROJECT_DEFAULTS = {
    "allowedTools": [],
    "mcpContextUris": [],
    "mcpServers": {},
    "enabledMcpjsonServers": [],
    "disabledMcpjsonServers": [],
    "hasTrustDialogAccepted": False,
    "hasClaudeMdExternalIncludesApproved": False,
    "hasClaudeMdExternalIncludesWarningShown": False,
}


def trust_home(config):
    projects = config.setdefault("projects", {})
    entry = projects.setdefault(HOME, dict(PROJECT_DEFAULTS))
    entry["hasTrustDialogAccepted"] = True

raw = sys.stdin.read()
if not raw.strip():
    fresh = dict(ENFORCED)
    trust_home(fresh)
    sys.stdout.write(json.dumps(fresh, indent=2, ensure_ascii=False))
    sys.exit(0)
try:
    current = json.loads(raw)
except ValueError:
    sys.stdout.write(raw)
    sys.exit(0)
if not isinstance(current, dict):
    sys.stdout.write(raw)
    sys.exit(0)

current.update(ENFORCED)
trust_home(current)
# no trailing newline: Claude Code writes the file without one, and adding it
# would make every apply rewrite 90KB.
sys.stdout.write(json.dumps(current, indent=2, ensure_ascii=False))
