{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openai/gpt-6-astra",
  "lsp": {
    "pyright": {
      "command": ["bun", "x", "--package", "pyright@1.1.411", "pyright-langserver", "--stdio"]
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "low"
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "skill": {
      "*": "allow",
      "context7-mcp": "deny"
    }
  }
}
