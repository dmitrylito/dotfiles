# Calendars that get a full-screen alert, by name as `gcalcli list` prints them.
# Semicolon-separated. Empty means nothing is scheduled.
CALENDARS="Work;Demo Meetings"
LEAD_SECONDS=120
HORIZON_HOURS=12
AUTO_DISMISS_SECONDS=120
SNOOZE_MINUTES=5
# Chromium profile (name or account email) the Join button opens the link in.
# Empty falls back to xdg-open, i.e. the default browser profile.
JOIN_PROFILE="Work"
