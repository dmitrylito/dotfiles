[Unit]
Description=Send a background Claude session's state to Herdr when it is opened in the agents view
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/herdr-bg-status-replay
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
