[Unit]
Description=Mirror Claude background sessions into herdr session "agents" tabs
BindsTo=herdr-agents.service
After=herdr-agents.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/herdr-agent-tabs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
