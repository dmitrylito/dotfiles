[Unit]
Description=Name Herdr app tabs after their Claude Code session
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/herdr-tab-titles
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
