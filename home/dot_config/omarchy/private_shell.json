{
  "bar": {
    "background": "glassy",
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "dmitrylito.indicators"
        },
        {
          "id": "omarchy.elsewhen",
          "hour24": true,
          "cities": [
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Beijing",
              "zone": "Asia/Shanghai"
            }
          ]
        },
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "dmitrylito.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "dmitrylito.agents"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omacom.notification-center"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "dmitrylito.notifications",
    "dmitrylito.reminders"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.reminders",
    "omarchy.idle"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "dmitrylito.notifications"
    },
    {
      "id": "dmitrylito.meeting-alert"
    },
    {
      "id": "dmitrylito.reminders"
    },
    {
      "id": "dmitrylito.display-idle"
    },
    {
      "id": "dmitrylito.window-time"
    }
  ],
  "version": 1
}
