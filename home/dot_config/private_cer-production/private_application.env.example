# Encrypt this file with systemd-creds; never install it as plaintext.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
GOOGLE_MAPS_API_KEY=replace-with-google-api-key
WEBHOOK_SECRET=replace-with-webhook-secret
DATABASE_URL=postgresql://postgres:replace-with-url-encoded-password@db:5432/cer_backend

SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=quotes@example.com
SMTP_USE_TLS=true

SALES_SMTP_HOST=replace-with-sales-smtp-host
SALES_SMTP_PORT=587
SALES_SMTP_USERNAME=replace-with-sales-smtp-username
SALES_SMTP_PASSWORD=replace-with-sales-smtp-password
SALES_SMTP_FROM_EMAIL=estimates@example.com
SALES_SMTP_FROM_NAME=Carolina Elite Roofing
SALES_SMTP_USE_TLS=true
SALES_SECOND_EMAIL_SEND=estimates@example.com
