{{- /* Renders one top-level group of .secrets.yaml.age as KEY=value lines.
       Call: template "secrets-env" (dict "group" "<name>" "export" true|false)
       Values are written unquoted, so a value with spaces or shell metacharacters
       breaks files that get sourced; quote it inside the YAML string if needed. */ -}}
{{- $all := include ".secrets.yaml.age" | decrypt | fromYaml -}}
{{- if not (hasKey $all .group) }}{{ fail (printf "secrets group %q missing from .secrets.yaml.age" .group) }}{{ end -}}
{{- range $key, $value := index $all .group }}
{{ if $.export }}export {{ end }}{{ $key }}={{ $value }}
{{- end -}}
