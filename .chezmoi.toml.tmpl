{{- $profile := promptStringOnce . "profile" "Machine profile (Omarchy, server, mac)" -}}
{{- $work := promptBoolOnce . "work" "Enable work configuration" false -}}
# This repo is public, so anything secret must be committed encrypted.
# The identity lives outside the source tree and is never committed; copy it to a new
# machine out of band before the first `chezmoi apply`, or encrypted files stay unreadable.
encryption = "age"
# Avoid external age shims: encryption must work before mise is configured.
useBuiltinAge = true

[data]
    profile = {{ $profile | lower | quote }}
    work = {{ $work }}

[age]
    identity = {{ (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt") | quote }}
    recipient = "age1dwdeg394lmtkmp5wn682kqpx7jjrtkl6mcgfn6pzggklj6xm3d2sqv3chk"

[git]
    # Publish source changes made through chezmoi. Plain editor writes remain
    # manual so partially written files are not pushed on every save.
    autoCommit = true
    autoPush = true

# chezmoi appends the destination/source/target files automatically when
# args contains no template placeholders
[merge]
    command = "nvim"
    args = ["-d"]
