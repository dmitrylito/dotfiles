ENFORCED_SCALARS = {
    # Terse ships in dot_claude/output-styles and carries Proactive's execution guidance in
    # its own text, so switching away from the built-in style loses nothing.
    "outputStyle": "Terse",
    "terminalProgressBarEnabled": False,
}


def clone(value):
    return json.loads(json.dumps(value))


def fill_defaults(live, defaults):
    for key, value in defaults.items():
        if isinstance(value, dict) and isinstance(live.get(key), dict):
            fill_defaults(live[key], value)
        elif key not in live:
            live[key] = clone(value)


def is_moshi_command(command):
    if not isinstance(command, str) or not command:
        return False
    token = command.split(" ", 1)[0].strip("'\"")
    return token.rsplit("/", 1)[-1] in MOSHI_BINARIES


def moshi_groups(groups):
    for group in groups if isinstance(groups, list) else []:
        if not isinstance(group, dict):
            continue
        entries = group.get("hooks")
        if isinstance(entries, list) and any(
            isinstance(e, dict) and is_moshi_command(e.get("command")) for e in entries
        ):
            yield group


def enforce_moshi_hooks(live, baseline):
    hooks = live if isinstance(live, dict) else {}
    for event, groups in baseline.items():
        existing = hooks.get(event)
        if not isinstance(existing, list):
            existing = hooks[event] = []
        for group in groups:
            matcher = group.get("matcher")
            if not any(g.get("matcher") == matcher for g in moshi_groups(existing)):
                existing.append(clone(group))
    for groups in hooks.values():
        for group in moshi_groups(groups):
            for entry in group["hooks"]:
                if isinstance(entry, dict) and is_moshi_command(entry.get("command")):
                    entry["command"] = MOSHI_COMMAND
    return hooks


def is_style_group(group):
    entries = group.get("hooks") if isinstance(group, dict) else None
    return isinstance(entries, list) and any(
        isinstance(e, dict) and "style-guard.py" in str(e.get("command", ""))
        for e in entries
    )


def enforce_style_hooks(hooks):
    """The style guard is not opt-in: any drifted or deleted copy is replaced by the
    canonical group, so editing settings.json cannot switch enforcement off. Disable it
    for one session with STYLE_GUARD=0 in the environment instead."""
    for event, groups in list(hooks.items()):
        if event not in STYLE_HOOKS and isinstance(groups, list):
            groups[:] = [g for g in groups if not is_style_group(g)]
    for event, (mode, timeout) in STYLE_HOOKS.items():
        groups = hooks.get(event)
        if not isinstance(groups, list):
            groups = hooks[event] = []
        groups[:] = [g for g in groups if not is_style_group(g)]
        groups.append(
            {
                "hooks": [
                    {
                        "command": STYLE_GUARD + mode,
                        "timeout": timeout,
                        "type": "command",
                    }
                ]
            }
        )
    return hooks


def is_isolation_group(group):
    entries = group.get("hooks") if isinstance(group, dict) else None
    return isinstance(entries, list) and any(
        isinstance(e, dict) and "isolation-guard.py" in str(e.get("command", ""))
        for e in entries
    )


def enforce_isolation_hooks(hooks):
    """Same deal as the style guard: enforced, not opt-in, so a settings.json edit cannot
    switch collision protection off. Use ISOLATION_GUARD=0 for one session instead."""
    for event, mode, matcher, timeout in ISOLATION_HOOKS:
        groups = hooks.get(event)
        if not isinstance(groups, list):
            groups = hooks[event] = []
        groups[:] = [g for g in groups if not is_isolation_group(g)]
        group = {
            "hooks": [
                {
                    "command": ISOLATION_GUARD + mode,
                    "timeout": timeout,
                    "type": "command",
                }
            ]
        }
        if matcher:
            group["matcher"] = matcher
        groups.append(group)
    return hooks


def enforce_scalars(live, enforced):
    for key, value in enforced.items():
        live[key] = clone(value)
    return live


def enforce_disabled_plugins(live, names):
    if not names:
        return live
    plugins = live.setdefault("enabledPlugins", {})
    if not isinstance(plugins, dict):
        plugins = live["enabledPlugins"] = {}
    for name in names:
        plugins[name] = False
    return live


def enforce_allow(live, baseline):
    permissions = live.setdefault("permissions", {})
    allow = permissions.get("allow")
    if not isinstance(allow, list):
        allow = permissions["allow"] = []
    for rule in baseline.get("allow", []):
        if rule not in allow:
            allow.append(rule)
    return allow


raw = sys.stdin.read()
try:
    current = json.loads(raw) if raw.strip() else {}
except ValueError:
    current = {}
if not isinstance(current, dict):
    current = {}

fill_defaults(current, {k: v for k, v in BASELINE.items() if k != "hooks"})
current["hooks"] = enforce_moshi_hooks(current.get("hooks"), BASELINE["hooks"])
enforce_style_hooks(current["hooks"])
enforce_isolation_hooks(current["hooks"])
enforce_scalars(current, ENFORCED_SCALARS)
enforce_disabled_plugins(current, DISABLED_PLUGINS)
enforce_allow(current, BASELINE["permissions"])

print(json.dumps(current, indent=2, sort_keys=True))
