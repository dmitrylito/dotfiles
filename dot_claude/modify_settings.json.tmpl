#!/usr/bin/env python3
# modify_settings.json — computes ~/.claude/settings.json from whatever is already there.
#
# Usage: not run by hand. chezmoi executes this on every `apply`, passing the CURRENT
#        target file on stdin; stdout becomes the new file. Empty stdin on a fresh
#        machine, which yields BASELINE verbatim.
#
# Why a modify_ script instead of a plain tracked file: Claude Code owns this file at
# runtime. /model, /config, /plugin and /permissions all rewrite it, and moshi-hook's
# installer rewrites the whole hooks block. A tracked file therefore drifted constantly,
# so every `chezmoi apply` stopped to ask whether to overwrite it, and answering yes threw
# away real settings changes. Here the live file is the INPUT, so there is nothing to
# overwrite and no prompt.
#
# The merge policy:
#   - BASELINE keys are DEFAULTS: filled in only where the live file lacks them, so a
#     setting changed inside Claude Code sticks, and a new BASELINE key still propagates.
#     "model" relies on this deliberately — it is seed-only, so switching between opus and
#     fable is never tracked or reverted. Do not move it into the enforced set.
#   - permissions.allow is ENFORCED as a union: every BASELINE rule is re-added if missing,
#     and rules added live (via /permissions) are kept. It has to be enforced rather than a
#     default because it is a LIST that already exists on every established machine, so
#     fill_defaults skipped it wholesale and each new rule silently reached only fresh boxes.
#     Removing a rule therefore means deleting it HERE, not in /permissions.
#   - ENFORCED_SCALARS are forced to the value here on every apply, overwriting whatever
#     the live file says. Use this only for settings that must be identical on every
#     machine. A DEFAULT is not enough for them: fill_defaults skips any key the live file
#     already has, so a box that once wrote the key keeps its old value forever and the
#     source silently stops being the truth. Changing one of these means editing it HERE —
#     a /config change to the same key is reverted on the next apply.
#   - DISABLED_PLUGINS is ENFORCED and per-profile: the plugins listed for this profile are
#     forced to false on every apply. It has to be enforced for the same reason as the allow
#     list — enabledPlugins already exists on every established box, so a BASELINE false
#     would be skipped by fill_defaults and never take. Re-enabling one means deleting it
#     from the list HERE; a /plugin toggle is reverted on the next apply.
#   - hooks are ENFORCED: every moshi hook command is forced back to the guard wrapper and
#     any missing event/matcher is re-added. Without this, `moshi-hook service install`
#     silently repoints the hooks at raw moshi-hook, bypassing Herdr binding repair and
#     making the Moshi app show the wrong conversation. Hooks the user added
#     themselves are left alone.
#
# A live file that will not parse is replaced by BASELINE — it was already broken.

import json
import sys

HOME = "{{ .chezmoi.homeDir }}"
MOSHI_COMMAND = "'" + HOME + "/.local/bin/moshi-hook-claude-guard' claude-hook"
MOSHI_BINARIES = ("moshi-hook", "moshi-hook-claude-guard", "moshi")

STYLE_GUARD = "python3 '" + HOME + "/.claude/hooks/style-guard.py' "
# event -> (mode, timeout). NOTHING here may block: a Stop rewrite left the discarded
# response, the instruction and the rewrite all in the transcript, re-sent every later turn.
# Stop is `observe`, which records to the verdict log and writes no output. SubagentStop is
# gone. The contract is enforced preventatively by the Terse output style instead.
STYLE_HOOKS = {
    "UserPromptSubmit": ("inject", 15),
    "Stop": ("observe", 15),
}

ISOLATION_GUARD = "python3 '" + HOME + "/.claude/hooks/isolation-guard.py' "
# event -> (mode, matcher, timeout). notify only warns at session start; guard denies the
# first write when another live session shares the repo, forcing EnterWorktree first.
ISOLATION_HOOKS = (
    ("SessionStart", "notify", None, 15),
    ("PreToolUse", "guard", "Write|Edit|NotebookEdit", 15),
)

