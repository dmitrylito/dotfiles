[tools]
{{ if dig "debug" false . -}}
# Debug USB: only the agent CLIs, gh, and the node herdr's drovr plugin needs.
# uv comes from pacman (packages/debug/pacman.txt) for the Codex config modifier.
claude = "latest"
codex = "latest"
gh = "latest"
node = "26"
{{- else -}}
agy = "latest"
bun = "latest"
claude = "latest"
{{ if ne (.profile | lower) "server" -}}
codex = "latest"
{{ end -}}
gh = "latest"
node = "26"
"npm:@hubspot/cli" = "latest"
"npm:pyright" = "latest"
opencode = "latest"
python = ["3.12", "3.14"]
{{- end }}

[settings]
minimum_release_age_excludes = ["claude", "codex"]
