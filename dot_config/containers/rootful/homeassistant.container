# Rootful: installed to /etc/containers/systemd/ by hand (chezmoi only deploys under ~).
# Root is needed for NET_ADMIN/NET_RAW on the host network, which HA's Bluetooth stack requires.
[Unit]
Description=Home Assistant
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data

[Container]
Image=ghcr.io/home-assistant/home-assistant:stable
AutoUpdate=registry
# HomeKit Bridge and device discovery need mDNS on the LAN itself.
Network=host
AddCapability=NET_ADMIN NET_RAW
Environment=TZ=America/New_York
HealthCmd=curl --fail http://127.0.0.1:8123
HealthInterval=60s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=300s
Volume=/data/docker-appdata/homeassistant:/config:Z
Volume=/etc/localtime:/etc/localtime:ro
Volume=/run/dbus:/run/dbus:ro

[Install]
WantedBy=multi-user.target

[Service]
Restart=always
TimeoutStopSec=70
