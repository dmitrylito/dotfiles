[Unit]
Description=go2rtc (Nest WebRTC to RTSP for HomeKit)
After=network-online.target
RequiresMountsFor=/data

[Container]
Image=ghcr.io/alexxit/go2rtc:latest
AutoUpdate=registry
# Home Assistant reaches it on 127.0.0.1:8554 only because both share the host namespace.
Network=host
Environment=TZ=America/New_York
Volume=/data/docker-appdata/go2rtc:/config:Z

[Install]
WantedBy=default.target

[Service]
Restart=always
