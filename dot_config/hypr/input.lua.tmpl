hl.config({
	input = {
		kb_layout = "us",
		kb_options = "compose:caps",
		repeat_rate = 40,
		repeat_delay = 600,
		numlock_by_default = true,
		follow_mouse = 1,
 		scroll_factor = 1.5,
{{- if eq .chezmoi.hostname "omarchy" }}
		-- Gaming box: a different mouse, and aiming needs unaccelerated 1:1 motion.
		accel_profile = "flat",
		sensitivity = 0.4,
 		natural_scroll = true,
{{- else if eq .chezmoi.hostname "fcoffice" }}
		accel_profile = "adaptive",
		sensitivity = 0.3,
{{- else }}
		accel_profile = "adaptive",
		sensitivity = 0.4,
		scroll_factor = 1.5,
{{- end }}
		natural_scroll = false,
		touchpad = {
			scroll_factor = 0.4,
		},
	},
})

o.window({ class = "(Alacritty|kitty|foot)" }, { scroll_touchpad = 1.5 })
o.window({ class = "com.mitchellh.ghostty" }, { scroll_touchpad = 0.2 })
