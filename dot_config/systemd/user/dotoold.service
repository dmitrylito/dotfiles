[Unit]
Description=dotool daemon (persistent uinput device for fast typing)
Documentation=https://sr.ht/~geb/dotool/
PartOf=graphical-session.target
After=graphical-session.target
# voxtype's dotool driver writes to this daemon's pipe; have it up first.
Before=voxtype.service

[Service]
Type=simple
ExecStart=/usr/bin/dotoold
Restart=on-failure
RestartSec=2
# SIGTERM at logout ends it with 143; without this every logout logs a failure.
SuccessExitStatus=143

[Install]
WantedBy=graphical-session.target
