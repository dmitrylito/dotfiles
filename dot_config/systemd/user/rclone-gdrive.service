[Unit]
Description=Mount Google Drive and shared drives at ~/GoogleDrive (rclone)
PartOf=graphical-session.target
After=graphical-session.target network-online.target

[Service]
Type=notify
ExecStartPre=-/usr/bin/fusermount3 -uz %h/GoogleDrive
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
ExecStart=/usr/bin/rclone mount gdrive-all: %h/GoogleDrive \
  --drive-export-formats link.html \
  --vfs-cache-mode full \
  --vfs-cache-max-age 24h \
  --dir-cache-time 12h \
  --poll-interval 15s \
  --umask 022 \
  --cache-dir %h/.cache/rclone \
  --volname GoogleDrive \
  --log-level INFO
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
