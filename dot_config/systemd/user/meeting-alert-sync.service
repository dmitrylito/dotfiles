[Unit]
Description=Schedule full-screen alerts for upcoming calendar meetings
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/meeting-alert sync
TimeoutStartSec=2min
# meeting-alert exits 75 on a gcalcli network error; the next run retries.
SuccessExitStatus=75
Nice=10
