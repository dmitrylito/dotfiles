# vim: set filetype=zsh:

# Keep this file as the startup map. Substantial custom behavior lives in
# ~/.config/zsh so it can be understood and tested independently.

source_if_exists() {
  [[ -f $1 ]] && source "$1"
}

# Attach only from a real terminal. Herdr pane shells and agent harnesses must
# never recursively attach, and server shells are entered through herdr --remote.
{{ if ne (.profile | lower) "server" -}}
if [[ -t 0 && -z ${CLAUDECODE:-} && -z ${HERDR_PANE_ID:-} ]] &&
    (( ${+commands[herdr]} )); then
  herdr
fi
{{- end }}

# Omarchy's environment must exist before plugins and interactive tools load.
{{- if eq (.profile | lower) "omarchy" }}
if [[ -z ${OMARCHY_PATH:-} ]]; then
  if [[ -d /usr/share/omarchy ]]; then
    export OMARCHY_PATH=/usr/share/omarchy
  else
    export OMARCHY_PATH="$HOME/.local/share/omarchy"
  fi
fi
[[ :$PATH: == *":$OMARCHY_PATH/bin:"* ]] || export PATH="$OMARCHY_PATH/bin:$PATH"
source_if_exists "$OMARCHY_PATH/default/bash/envs"
{{- end }}

# Oh My Zsh initializes Zsh's completion system. Carapace loads afterward,
# once compdef exists, and supplies the command-aware completion functions.
export ZSH="$HOME/.oh-my-zsh"
ZSH_CUSTOM="$ZSH/custom"
zstyle ':omz:update' mode auto

source_if_exists "$XDG_CONFIG_HOME/zsh/completion-setup.zsh"

plugins=(
  git
  github
{{ if ne (.profile | lower) "mac" }}  archlinux
{{ end }}  tailscale
  sudo
  docker
  docker-compose
  gpg-agent
  gcloud
  uv
  fzf
)

# Ansible owns external plugin installation. Skip plugins until the first
# reconciliation finishes instead of making a fresh machine's shell error.
for plugin in zsh-sage you-should-use zsh-syntax-highlighting; do
  [[ -d "$ZSH_CUSTOM/plugins/$plugin" ]] && plugins+=("$plugin")
done
unset plugin

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit -d "$ZSH_COMPDUMP"
fi
source_if_exists "$XDG_CONFIG_HOME/zsh/carapace.zsh"

# Interactive shell behavior.
setopt AUTO_CD SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS INC_APPEND_HISTORY GLOB_DOTS PROMPT_SUBST EXTENDED_GLOB

# Avoid expensive highlighting passes on very large command buffers.
ZSH_HIGHLIGHT_MAXLENGTH=512

source_if_exists "$HOME/Projects/fc-cli/zsh_completion.sh"
source_if_exists "$HOME/.aliases"

autoload -Uz add-zsh-hook
source_if_exists "$XDG_CONFIG_HOME/zsh/keybindings.zsh"
source_if_exists "$XDG_CONFIG_HOME/zsh/remote-session-cleanup.zsh"
source_if_exists "$XDG_CONFIG_HOME/zsh/tools.zsh"

{{- if eq (.profile | lower) "omarchy" }}
# hyprmon must write to the unmanaged file sourced by the managed Hyprland config.
alias hyprmon='HYPRLAND_CONFIG="$HOME/.config/hypr/monitors.conf" command hyprmon'

_sync_hypr_signature() {
  (( ${+commands[systemctl]} )) || return
  local signature
  signature=$(systemctl --user show-environment 2>/dev/null |
    awk -F= '$1 == "HYPRLAND_INSTANCE_SIGNATURE" { print $2 }')
  if [[ -n $signature && ${HYPRLAND_INSTANCE_SIGNATURE:-} != $signature ]]; then
    export HYPRLAND_INSTANCE_SIGNATURE=$signature
  fi
}
_sync_hypr_signature

hyprctl() {
  _sync_hypr_signature
  command hyprctl "$@"
}
{{- end }}

# Machine-local secrets and overrides are intentionally not managed by chezmoi.
source_if_exists "$HOME/.zshrc.local"

# Prompt initialization belongs near the end so it sees the final environment.
if (( ${+commands[starship]} )); then
  eval "$(starship init zsh)"
fi

source_if_exists "$XDG_CONFIG_HOME/zsh/chezmoi-autoupdate.zsh"
