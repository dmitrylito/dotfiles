{{- $profile := .profile | lower -}}
{{- $work := .work -}}
# Repo tooling — lives in the chezmoi source dir, never deployed to $HOME
README.md
CLAUDE.md
package-lock.json
playbook.yml
ansible.cfg
packages/
scripts/
docs/

# WM / editor state that is machine-specific or generated
.config/hypr/shaders/
.config/hypr/monitors.lua
.config/hypr/workspaces.lua
.config/nvim/lazy-lock.json

# Auto-memory is per-machine runtime state that the memory system rewrites constantly;
# managing it guarantees permanent drift and would sync one box's memories onto another.
.claude/projects/*/memory/

# Bytecode regenerates on every run; managing it guarantees permanent drift.
.claude/hooks/__pycache__/

{{ if and (ne $profile "omarchy") (ne $profile "mac") }}
.config/ghostty/
{{ end }}

{{ if ne $profile "omarchy" }}
.config/hypr/
.config/voxtype/
.config/omarchy/
# Keeps hotplugged displays blank while the Omarchy session is locked.
.local/bin/omarchy-lock-dpms-guard
.config/systemd/user/omarchy-lock-dpms-guard.service
.config/systemd/user/dotoold.service
.config/systemd/user/herdr-server.service
.config/systemd/user/graphical-session.target.wants/
.config/mimeapps.list
.config/spotify-flags.conf
.local/bin/chromium-profile-launch
.local/bin/discord-ptm
.local/bin/work-mode
.local/share/applications/
.XCompose
{{ end }}

{{ if not $work }}
# Fleet Chaser project tooling belongs to the work role, regardless of platform.
Projects/fleetchaser/
.config/fleetchaser-mypy.ini
.local/bin/fc-dmypy
.local/bin/fc-mypy
.local/bin/import-db
.local/bin/work-mode
.claude/skills/restack-migrations/
.claude/skills/state-mileage-import/

# Work-only Omarchy launchers. Personal Chromium/YouTube launchers remain.
.local/share/applications/DL-Chrome-FCChat.desktop
.local/share/applications/DL-Chrome-FCTasks.desktop
.local/share/applications/DL-Chrome-Work.desktop
.local/share/applications/FC Chat.desktop
.local/share/applications/FC Gmail.desktop
.local/share/applications/FC Tasks.desktop
.local/share/applications/FC-Dialpad.desktop
.local/share/applications/Linear.desktop
.local/share/applications/Work Mode.desktop
.local/share/applications/icons/Dialpad.png
.local/share/applications/icons/FC Chat.png
.local/share/applications/icons/FC Gmail.png
.local/share/applications/icons/FC Tasks.png
.local/share/applications/icons/Linear.png
{{ end }}

{{ if or (ne $profile "omarchy") (ne .chezmoi.hostname "fcoffice") }}
# Granite Ridge iGPU/9070 XT ordering is specific to the fcoffice desktop.
.config/environment.d/
{{ end }}

{{ if ne $profile "mac"}}
.config/aerospace/
.config/sketchybar/
.config/borders/
{{ end }}

{{ if eq $profile "mac" }}
# macOS has launchd, not systemd — the whole user-units tree is Linux-only.
.config/systemd/
{{ end }}

{{ if ne $profile "server" }}
# Podman quadlets and their app config live only where the containers run.
.config/containers/systemd/
docker-appdata/

# Remote Control daemon only makes sense on the always-on server.
.config/systemd/user/claude-rc.service
.config/systemd/user/claude-rc@.service
.config/systemd/user/chezmoi-package-capture.service
.config/systemd/user/chezmoi-package-capture.timer
{{ end }}

{{ if or (ne $profile "server") (ne .chezmoi.hostname "dlco-prod") }}
# Production deployment is owned by dlco-prod, not every Linux host.
.config/cer-production/
.local/libexec/cer-production/
.local/bin/cer-production-watch
.config/systemd/user/cer-production-watch.service
.config/systemd/user/cer-production-watch.timer
{{ end }}
