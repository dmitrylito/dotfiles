{{- $profile := .profile | lower -}}
{{- $work := .work -}}
# Repo tooling — lives in the chezmoi source dir, never deployed to $HOME
README.md
package-lock.json
playbook.yml
ansible.cfg
packages/
scripts/
docs/
system/

# WM / editor state that is machine-specific or generated
.config/hypr/shaders/
.config/hypr/monitors.lua
.config/hypr/workspaces.lua
.config/nvim/lazy-lock.json

# Auto-memory is per-machine runtime state that the memory system rewrites constantly;
# managing it guarantees permanent drift and would sync one box's memories onto another.
.claude/projects/*/memory/

# Bytecode regenerates on every run; managing it guarantees permanent drift.
.claude/hooks/__pycache__/
.local/libexec/fc-daily-report/__pycache__/

{{ if and (ne $profile "omarchy") (ne $profile "mac") }}
.config/ghostty/
{{ end }}

{{ if ne $profile "omarchy" }}
.claude/rules/hyprland.md
.config/hypr/
.config/voxtype/
.config/omarchy/
# Keeps hotplugged displays blank while the Omarchy session is locked.
.local/bin/omarchy-lock-dpms-guard
.config/systemd/user/omarchy-lock-dpms-guard.service
.config/systemd/user/dotoold.service
.config/systemd/user/herdr-server.service
.config/systemd/user/rclone-gdrive.service
.config/systemd/user/graphical-session.target.wants/
.config/mimeapps.list
.config/spotify-flags.conf
.local/bin/chromium-profile-launch
.config/chromium-flags.conf
.config/chromium/NativeMessagingHosts/dev.dmitrylito.window_time.json
.local/share/window-time/
.local/bin/window-time-tab-host
.local/bin/discord-ptm
.local/bin/work-mode
.local/share/applications/
.XCompose
{{ end }}

{{ if and (not $work) (ne .chezmoi.hostname "DLCO-1") }}
# FC API login for fc-daily-report: work machines, plus DLCO-1, where the daily-report
# skill and the ops center (which holds the same login) run.
.config/secrets/fc-api.env
{{ end }}

{{ if not $work }}
