.local/share/applications/icons/Linear.png
{{ end }}

{{ if or (ne $profile "omarchy") (ne .chezmoi.hostname "fcoffice") }}
# Granite Ridge iGPU/9070 XT ordering is specific to the fcoffice desktop.
.config/environment.d/
# Shim for the local voxtype GPU-encoder fork, which only fcoffice builds.
.local/bin/voxtype
{{ end }}

{{ if and (eq $profile "omarchy") (eq .chezmoi.hostname "fcoffice") }}
# fcoffice uses stock lock-screen DPMS only; ignoring the wants link leaves the guard disabled.
.config/systemd/user/graphical-session.target.wants/omarchy-lock-dpms-guard.service
{{ end }}

{{ if ne $profile "mac"}}
.config/aerospace/
.config/sketchybar/
.config/borders/
Library/
{{ end }}

{{ if eq $profile "mac" }}
# macOS has launchd, not systemd — the whole user-units tree is Linux-only.
.config/systemd/
{{ end }}

{{ if ne $profile "server" }}
# Podman quadlets and their app config live only where the containers run.
.config/containers/
docker-appdata/

# Remote Control daemon only makes sense on the always-on server.
.config/systemd/user/claude-rc.service
.config/systemd/user/claude-rc@.service
.config/systemd/user/codex-remote.service
.config/secrets/github-mcp.env
.config/systemd/user/chezmoi-package-capture.service
.config/systemd/user/chezmoi-package-capture.timer
{{ end }}

{{ if eq $profile "server" }}
# The native installer owns this pointer; the mise shim breaks fresh servers.
.codex/packages/standalone/current
{{ end }}

{{ if or (ne $profile "server") (ne .chezmoi.hostname "DLCO-3") }}
# Production deployment is owned by DLCO-3, not every Linux host.
.config/cer-production/
.local/libexec/cer-production/
.local/bin/cer-production-watch
.config/systemd/user/cer-production-watch.service
.config/systemd/user/cer-production-watch.timer
{{ end }}

{{ if ne $profile "server" }}
.config/secrets/caddy.env
{{ end }}

# The Caddy + keepalived reverse-proxy stack runs only on the three VIP nodes.
{{ if not (has .chezmoi.hostname (list "DLCO-1" "DLCO-2" "DLCO-3")) }}
docker-appdata/caddy/
{{ end }}

