#!/usr/bin/env -S uv run --no-project --with tomlkit==0.13.3 python
# modify_config.toml — merge the managed Codex baseline into live app state.
#
# Codex owns ~/.codex/config.toml at runtime: project trust, hook trust hashes,
# desktop preferences, and other state are written as the app is used. Tracking
# the whole file as an immutable snapshot caused permanent Chezmoi drift and
# made apply overwrite valid local state.
#
# The encrypted baseline seeds a new machine. On an established machine, keys
# missing from the live file are filled recursively while existing local values
# are preserved, except for explicitly synchronized settings below. uv supplies
# the pinned TOML dependency independently of the machine's active Python.
# Dependency failures must fail apply, never silently skip synchronization.

import copy
import subprocess
import sys
from collections.abc import MutableMapping
from pathlib import Path

import tomlkit

SOURCE_DIR = Path({{ .chezmoi.sourceDir | quote }})
BASELINE_PATH = SOURCE_DIR / "scripts/codex-config-baseline.toml.age"
RETIRED_MCP_SERVERS = {"node_repl"}
SYNCHRONIZED_SETTINGS = (("tui", "status_line"),)


def read_baseline():
    result = subprocess.run(
        ["chezmoi", "--use-builtin-age=true", "decrypt", str(BASELINE_PATH)],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    return result.stdout


def strip_retired_servers(text):
    """Remove retired MCP tables without requiring a TOML writer."""
    output = []
    skipping = False
    for line in text.splitlines(keepends=True):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            table = stripped.strip("[]").strip()
            skipping = any(
                table == f"mcp_servers.{server}"
                or table.startswith(f"mcp_servers.{server}.")
                for server in RETIRED_MCP_SERVERS
            )
        if not skipping:
            output.append(line)
    return "".join(output)


def fill_defaults(live, baseline):
    for key, value in baseline.items():
        if key not in live:
            live[key] = copy.deepcopy(value)
        elif isinstance(live[key], MutableMapping) and isinstance(value, MutableMapping):
            fill_defaults(live[key], value)


def remove_retired_servers(config):
    servers = config.get("mcp_servers")
    if isinstance(servers, MutableMapping):
        # This server belongs to the packaged ChatGPT desktop runtime. The
        # standalone Codex installation has no such binary, so retaining the
        # registration makes every Codex process report a startup failure.
        servers.pop("node_repl", None)


def synchronize_settings(live, baseline):
    for path in SYNCHRONIZED_SETTINGS:
        source = baseline
        target = live
        for key in path[:-1]:
            source = source[key]
            target = target[key]
        target[path[-1]] = copy.deepcopy(source[path[-1]])


def migrate_context7_credentials(config):
    """Replace the legacy inline key with the shared environment credential."""
    server = config.get("mcp_servers", {}).get("context7")
    if not isinstance(server, MutableMapping):
        return
    headers = server.get("http_headers")
    if isinstance(headers, MutableMapping):
        headers.pop("CONTEXT7_API_KEY", None)
        if not headers:
            del server["http_headers"]
    server.setdefault("env_http_headers", {})["CONTEXT7_API_KEY"] = "CONTEXT7_API_KEY"


live_text = strip_retired_servers(sys.stdin.read())
baseline_text = strip_retired_servers(read_baseline())

if not live_text.strip():
    sys.stdout.write(baseline_text)
    raise SystemExit(0)

try:
    live = tomlkit.parse(live_text)
    baseline = tomlkit.parse(baseline_text)
except Exception as error:
    print(f"codex config merge refused invalid TOML: {error}", file=sys.stderr)
    raise SystemExit(1)

fill_defaults(live, baseline)
synchronize_settings(live, baseline)
remove_retired_servers(live)
migrate_context7_credentials(live)
sys.stdout.write(tomlkit.dumps(live))
