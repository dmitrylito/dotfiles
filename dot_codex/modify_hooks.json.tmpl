#!/usr/bin/env python3
# Preserve runtime-owned hooks and enforce one Moshi handler per managed event.
# Usage: chezmoi apply ~/.codex/hooks.json; reads existing JSON on stdin.
# Requires Python 3 and installed Moshi integration commands.

import json
import sys

USER_HOME = "{{ .chezmoi.homeDir }}"
# Quotes and the trailing `codex-hook` are load-bearing: this is the exact shape
# `moshi-hook status` matches, and anything else is reported as stale wiring.
MOSHI_COMMAND = "'" + USER_HOME + "/.local/bin/moshi-hook-codex-guard' codex-hook"
MOSHI_BINARIES = ("moshi-hook-codex-guard", "moshi-codex-hook", "moshi-hook", "moshi")
EVENTS = ("PermissionRequest", "SessionStart", "Stop", "UserPromptSubmit")


def is_moshi_command(command):
    if not isinstance(command, str) or not command:
        return False
    token = command.split(" ", 1)[0].strip("'\"")
    return token.rsplit("/", 1)[-1] in MOSHI_BINARIES


def without_moshi(groups):
    kept = []
    for group in groups if isinstance(groups, list) else []:
        if not isinstance(group, dict):
            kept.append(group)
            continue
        entries = group.get("hooks")
        if not isinstance(entries, list):
            kept.append(group)
            continue
        remaining = [
            entry
            for entry in entries
            if not (
                isinstance(entry, dict)
                and is_moshi_command(entry.get("command"))
            )
        ]
        if remaining:
            group = dict(group)
            group["hooks"] = remaining
            kept.append(group)
    return kept


raw = sys.stdin.read()
try:
    current = json.loads(raw) if raw.strip() else {}
except ValueError as error:
    raise SystemExit(f"Invalid Codex hooks JSON; refusing to overwrite: {error}")
if not isinstance(current, dict):
    raise SystemExit("Codex hooks configuration must be an object; refusing to overwrite")

hooks = current.setdefault("hooks", {})
if not isinstance(hooks, dict):
    raise SystemExit("Codex hooks must be an object; refusing to overwrite")

for event in EVENTS:
    if event in hooks and not isinstance(hooks[event], list):
        raise SystemExit(f"Codex {event} hooks must be a list; refusing to overwrite")

for event in EVENTS:
    groups = without_moshi(hooks.get(event))
    groups.append(
        {"hooks": [{"command": MOSHI_COMMAND, "type": "command"}]}
    )
    hooks[event] = groups

print(json.dumps(current, indent=2, sort_keys=True))
