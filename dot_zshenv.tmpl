# vim: set filetype=zsh:

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

if [[ -z "${TERM:-}" || "$TERM" == "dumb" ]] || ! tput longname >/dev/null 2>&1; then
  export TERM="xterm-256color"
fi

# herdr's server spawns pane shells with no LANG/LC_*; in the C locale zle
# counts multibyte prompt glyphs per-byte, so every redraw drifts right.
if [[ -z "${LANG:-}" && -z "${LC_ALL:-}" ]]; then
  export LANG="C.UTF-8"
fi

# Same herdr gap for XDG_RUNTIME_DIR: without it moshi-hook's client falls back to
# /tmp/moshi-hook.sock while the daemon listens on $XDG_RUNTIME_DIR/moshi-hook.sock,
# so hook events are written locally but never reach the Moshi app.
if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$(id -u)" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

export EDITOR="$HOME/.local/share/bob/nvim-bin/nvim"
export VISUAL="$EDITOR"
export PAGER="less"
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship.toml"
export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/application_default_credentials.json"
export GOOGLE_CLOUD_LOCATION="global"

# Shared credentials are stored age-encrypted in the Chezmoi source.
if [[ -r "$HOME/.config/secrets/shared.env" ]]; then
  source "$HOME/.config/secrets/shared.env"
fi

# Machine-local secrets/env (NOT managed by chezmoi — never add it).
if [[ -f "$HOME/.env" ]]; then
  source "$HOME/.env"
fi

# Fullscreen (alt-screen) rendering so Claude Code stops full-viewport redraws.
export CLAUDE_CODE_NO_FLICKER=1
# Labels this machine in the `remember` plugin's memory headers (server/omarchy/mac).
export REMEMBER_BRANCH={{ .profile }}
{{- if and (eq (.profile | lower) "omarchy") (eq .chezmoi.hostname "fcoffice") }}
# Hyprland/Wayland only — nothing else on any profile reads these.
export YDOTOOL_SOCKET="$HOME/.ydotool_socket"
# HYPRLAND_CONFIG must NOT be exported globally: Omarchy v4's Hyprland treats it
# as an explicit config override and skips the hyprland.lua provider entirely.
# hyprmon gets it per-command via an alias in .zshrc.
# Hide the Granite Ridge iGPU (gfx1036, 0000:0f:00.0) from ROCm so HIP device 0 is
# always the 9070 XT (gfx1201) and no app can pick the raster iGPU as a compute
# device. Index 0 is PCI-enumeration order (03:00.0 < 0f:00.0); if the slots ever
# change, re-check `rocminfo | grep gfx`. Mirrored in .config/environment.d for
# systemd user services, which never read this file.
export ROCR_VISIBLE_DEVICES=0
export HIP_VISIBLE_DEVICES=0
{{- end }}

typeset -U path
path=(
  $HOME/.local/bin
  $HOME/go/bin
  $HOME/.cargo/bin
  $HOME/.cache/.bun/bin
  $HOME/.opencode/bin
  $XDG_DATA_HOME/bob/nvim-bin
  /usr/local/bin
  $path
)

# Auth for GitHub MCP clients. Prefer the token currently authenticated by gh;
# inherited values can outlive a logout/login and become invalid.
# Never invoke the Mise bootstrap shim from .zshenv: this file runs for every
# Zsh process, and installing a missing gh version here can block shell startup.
_gh_path="${commands[gh]:-}"
if [[ "$_gh_path" == "$HOME/.local/bin/gh" ]]; then
  [[ -x /usr/bin/gh ]] && _gh_path=/usr/bin/gh
fi
if [[ -n "$_gh_path" ]]; then
  _github_token="$("$_gh_path" auth token 2>/dev/null)"
fi
_github_token="${_github_token:-${GITHUB_PERSONAL_ACCESS_TOKEN:-${GITHUB_MCP_PAT:-}}}"
if [[ -z "$_github_token" && "$OSTYPE" == darwin* ]] && command -v git >/dev/null 2>&1; then
  _github_token="$(printf 'protocol=https\nhost=github.com\n\n' \
    | git credential-osxkeychain get 2>/dev/null \
    | sed -n 's/^password=//p' | head -1)"
fi
# Exporting an empty value expands the MCP Authorization header to a bare
# "Bearer " and the server answers 400, so leave it unset instead.
[[ -n "$_github_token" ]] && export GITHUB_PERSONAL_ACCESS_TOKEN="$_github_token"
unset _github_token _gh_path

if [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# gcloud installs to a different prefix on every machine (pacman /opt, macOS
# homebrew, upstream tarball in $HOME) — probe instead of branching per profile.
# Setting CLOUDSDK_HOME is what makes it work everywhere: the omz `gcloud` plugin
# sources path.zsh.inc and completion.zsh.inc from it, but only otherwise probes
# /usr/share, so homebrew prefixes used to need their own branch.
for _gcloud_root in /opt/google-cloud-cli /opt/homebrew/share/google-cloud-sdk \
                    /usr/share/google-cloud-sdk "$HOME/google-cloud-sdk"; do
  if [[ -f "$_gcloud_root/path.zsh.inc" ]]; then
    export CLOUDSDK_HOME="${CLOUDSDK_HOME:-$_gcloud_root}"
    break
  fi
done
unset _gcloud_root
