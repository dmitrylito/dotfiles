# vim: set filetype=zsh:
alias n="nvim"
alias lg="lazygit"
alias lzd="lazydocker"
alias lzp='lazypodman'
alias cz="chezmoi"
alias czr="chezmoi re-add"
alias czu="chezmoi update"
alias cza="chezmoi apply"
alias se="secrets-edit"
alias py="python3"
alias c="clear"
alias sz="export CHEZMOI_AUTOUPDATE_FORCE=1; exec zsh"
alias nz="ce ~/.zshrc"
alias na="ce ~/.aliases"
alias ne="ce ~/.zshenv"
alias y="yazi"
alias cdz="cd ~/.local/share/chezmoi/"
alias cs="claude --model sonnet"
alias co="claude --model opus"

{{- if .work }}
alias cdpc="cd ~/Projects/cer-backend/"
alias cdpfb="cd ~/Projects/fleetchaser/backend/"
alias dvsc="docker-volume-snapshot create fleetchaser_db_volume $HOME/Projects/fleetchaser/tmp/docker/fleetchaser_db_volume"
alias dvsr="docker-volume-snapshot restore $HOME/Projects/fleetchaser/tmp/docker/fleetchaser_db_volume fleetchaser_db_volume"
{{- end }}

if command -v brew >/dev/null; then
  alias buu="brew update && brew upgrade"
fi

if command -v bat >/dev/null; then
  alias cat="bat --paging=never"
fi

ce() {
  chezmoi edit --apply "$@"
}

cdp() {
  cd ~/Projects/"$1"
}
compdef '_path_files -/ -W ~/Projects' cdp

if command -v eza >/dev/null; then
  alias ls="eza -T -L=1 --group-directories-first --color=always --icons=always"
  alias lsa="eza -a -l --group-directories-first --color=always --icons=always --git --time-style=relative --no-user"
  alias lt="eza -T -L=2 -l --group-directories-first --color=always --icons=always --git --no-user --no-permissions"
else
  alias ls="ls --color=auto"
  alias lsa="ls -a --color=auto"
fi

if command -v mise >/dev/null; then
  # Bypasses mise's built-in 24h minimum_release_age quarantine.
  alias mup='MISE_MINIMUM_RELEASE_AGE=0 mise up'
fi

if command -v systemctl >/dev/null; then
  alias sc="systemctl --user"
  alias scs="sudo systemctl"
fi

if command -v fzf >/dev/null; then
  # Functions, not aliases: ff has to be callable inside $(...) and pipelines below.
  ff() {
    local text_preview='bat --style=numbers --color=always {}'
    command -v bat >/dev/null || text_preview='cat {}'
    local preview=$text_preview
    if command -v chafa >/dev/null; then
      # Ghostty speaks the kitty graphics protocol, so chafa -f kitty draws real pixels.
      preview='case $(file --mime-type -b {}) in image/*) chafa -f kitty -s "${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}" {} ;; *) '$text_preview' ;; esac'
    fi
    fzf --preview "$preview" \
      --header 'enter print path · ctrl-y copy path · ctrl-o open · ctrl-e edit' \
      --bind 'ctrl-y:transform(printf %s {} | "$HOME/.local/bin/clipboard-copy" >/dev/null 2>&1 && printf abort || printf "change-header(Clipboard copy failed)")' \
      --bind 'ctrl-o:execute-silent(xdg-open {} >/dev/null 2>&1 &)+abort' \
      --bind "ctrl-e:execute(${EDITOR:-vi} {})" \
      "$@"
  }

  # Copy the picked path to the clipboard and print it.
  yf() {
    local file
    file=$(ff) && [ -n "$file" ] && printf %s "$file" | "$HOME/.local/bin/clipboard-copy" && printf '%s\n' "$file"
  }

  eff() {
    local file
    file=$(ff) && [ -n "$file" ] && "$EDITOR" "$file"
  }

  sff() {
    if [ $# -eq 0 ]; then
      echo "Usage: sff <destination> (e.g. sff dlco-1:/tmp/)"
      return 1
    fi
    local file
    file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff) && [ -n "$file" ] && scp "$file" "$1"
  }
fi
